[
    {imboy, [
        % 环境标识：local 宽松模式，跳过生产级密钥校验
        {env, local},
        % http服务端口
        {http_port, 20800},
        {http_port_adm, 20706},
        % 墨芽微信小程序本地联调（2026-09-10）：假 appid/secret + 本地 mock
        % jscode2session（/tmp/moya-automation/mock-jscode2session.mjs, 端口 9817）。
        % 全部为本地 mock 值，绝非真实凭据；真实值仅由用户在生产环境注入。
        {wechat_mini_appid, <<"mock-appid-local-dev">>},
        {wechat_mini_secret, <<"mock-secret-local-dev">>},
        {wechat_mini_jscode_url, <<"http://127.0.0.1:9817/sns/jscode2session">>},
        % 本地开发关闭签名验证（app_version 表为空时 sign_key 返回 <<>> 导致 902）
        {api_auth_switch, <<"off">>},
        % 本地支付验收：开启支付网关总开关（2026-08-20 支付激活计划，真机 mock 全链路回归用）
        {payment_gateway_enabled, true},
        % 支付宝沙箱验收（2026-08-20：生产商户未签约 App 支付 isv.insufficient-isv-permissions，
        % 用户拍板先走沙箱）。沙箱材料由用户提供后填入（或 IMBOY_* 环境变量注入，优先级更高）：
        %   appId / 应用私钥(RSA2) / 支付宝公钥 / 买家账号+沙箱版支付宝 APK。
        % 沙箱为公钥模式：证书 SN 留空即不下发（epay maybe_put 语义）。
        {alipay_app_id, <<>>},
        {alipay_private_key, <<>>},
        {alipay_public_key, <<>>},
        % 沙箱回调须公网可达；无隧道时经 rpc recharge_logic:mark_paid_and_credit/2 手动入账兜底
        {alipay_notify_url, <<>>},
        {alipay_gateway_url, <<"https://openapi-sandbox.dl.alipaydev.com/gateway.do">>},
        % 本地注册支付宝网关（默认注册表仅 mock/wallet）
        {payment_gateways, #{
            <<"alipay">> => payment_alipay_gateway
        }},
        %, {host, <<"dev.imboy.pub">>}
        {host, '_'},
        %, {cacertfile, "/ssl/dev.imboy.pub_chain.crt"}
        %, {certfile, "/ssl/dev.imboy.pub_public.crt"}
        %, {keyfile, "/ssl/dev.imboy.pub.key"}

        {cacertfile, "/ssl/cowboy-ca.crt"},
        {certfile, "/ssl/server.crt"},
        {keyfile, "/ssl/server.key"},
        {base_url, <<"https://dev.imboy.pub">>},

        % CORS 白名单（仅这些 Origin 允许跨域携带凭证）
        % 开发环境支持 localhost 任意端口
        {cors_allowed_origins, [
            <<"https://dev.imboy.pub">>,
            <<"http://localhost:8082">>,
            <<"http://localhost:56164">>
        ]},
        % 开发环境允许 localhost 任意端口（正则匹配）
        {cors_allow_localhost, true},

        %% 客户端 /init 接口返回的 URL 及上传配置
        %% ws_url: WebSocket 连接地址（wss:// 或 ws://）
        %% H2 真机走查（2026-08-30）：本地缺省不再配置 ws_url——/init 会按
        %% 请求 Host 同源派生（index_handler derive_ws_url/1），杜绝旧 IP 残留
        {upload_url, <<"https://s3.imboy.pub">>},

        %% Garage S3 本地测试配置（真实密钥，不提交到 git）
        %%
        %% 双 endpoint（对应 elib_oss:endpoint/0 与 public_endpoint/0）：
        %%   endpoint        服务端自用（put_object / head_object / delete_object），
        %%                   只被 Erlang 节点调用，走回环最稳、不受 LAN 网卡状态影响；
        %%   public_endpoint 会被签进交给客户端的 presign URL（直传 PUT / 回读 GET），
        %%                   必须「客户端可达」—— 127.0.0.1 在手机上指向手机自身
        %%                   （Connection refused），必须填本机 LAN IP。
        %% 2026-09-14 修正：原值 172.20.10.3（iPhone 热点网段）已不在本机任何网卡上，
        %% 实测 curl 直接连接失败 —— 服务端入桶（PUT）与客户端回读（GET）会双双失败。
        %% 改动后须重启节点才生效；换网络（热点 / 换 WiFi）时这三处要同步改。
        %% 2026-09-12 重建：docker 容器 garage-local（dxflrs/garage:v2.0.0，配置/数据挂载
        %% /tmp/garage），密钥 imboy-key 重建——旧实例数据已随 /tmp 清理丢失。
        {garage, #{
            endpoint => <<"http://127.0.0.1:3900">>,
            public_endpoint => <<"http://192.168.1.69:3900">>,
            region => <<"garage">>,
            bucket => <<"imboy">>,
            %% 公开读桶 + 客户端可达基址（阶段三配置 Garage website + nginx 后定稿）
            public_bucket => <<"imboy-public">>,
            public_base_url => <<"http://192.168.1.69:3902">>,
            access_key => <<"GK2324eb31841a6d0af02b4b25">>,
            secret_key => <<"048a83469f6a4d8af0bbe88dbaf967f8a96d16b5dfe9cb5afa35c25386eb9bbb">>
        }},

        {adm_cookie_secret, "cVQtrKNa"},

        % jwt_key binary 32 — IMBOY_JWT_KEY
        {jwt_key, <<"rPWaWDXmXwmNBCes8Dm94RhFBkwZFtnX">>},

        % solidified key（与 imboyapp .env.local_office/.env.local_home 一致：
        % 不配则按节点名派生 dev key，真机清数据后 /api/v1/init 配置解密
        % 失败、登录前置不就绪——2026-08-31 T2.7 真机走查实证）
        {solidified_key, <<"pLV8yWGUUnd3Y2gaHP5aggZ7wnKT9DqL">>},
        {solidified_key_iv, <<"e6Z8KuBnGCi2t7we">>},

        % 万能验证码（仅 local/test 环境）
        {verification_master_code, <<"abc12345">>},

        % 用于postgresql 存储数据的AES密钥 Key binary 32
        {postgre_aes_key, <<"rPWaWDXmXwmNBCes8Dm94RhFBkwZFtnX">>},

        % 百度千帆大模型相关配置
        {qianfan, #{
            app_id => 53511846,
            api_key => <<"rVEohmJ1H9UJhn15r11DVXTO">>,
            secret_key => <<"PbYQPnO0a9mkjSD4rdBHA4pnRyAn6PWL">>,
            auth_access_key => <<"858b3ebbdbfe398bb6482b47a4859dae">>,
            auth_secret_key => <<"F54c382590acd59a7f0e8d8668a97b9f">>
        }},

        % LLM provider 注册表（imboy_llm_registry）。火山方舟(Ark)/豆包为 OpenAI
        % 兼容端点，直接复用 imboy_llm_openai，无需新模块。
        % 密钥走环境变量 {env, <<"VAR">>}，绝不写死进配置文件：
        %   启动前 export ARK_API_KEY=<你的 ark key>  （之前泄露的 key 请先轮换）
        %   可选 export ARK_MODEL=<endpoint-id 或模型名>（缺省 doubao-lite-4k）
        % agent 建号时 provider 填 "ark" 即走此通路；agent 自带 model 覆盖默认。
        {llm_providers, [
            #{
                name => <<"ark">>,
                module => imboy_llm_openai,
                base_url => <<"https://ark.cn-beijing.volces.com/api/v3">>,
                api_key => {env, <<"ARK_API_KEY">>},
                model => {env, <<"ARK_MODEL">>, <<"doubao-lite-4k">>}
            }
            , #{
                name => <<"bailian">>,
                module => imboy_llm_openai,
                % 专属模型网关端点（CSV 交付），勿用通用 dashscope 域名
                base_url => <<"https://llm-zyz63lgdmo1wvx8k.cn-beijing.maas.aliyuncs.com/compatible-mode/v1">>,
                api_key => {env, <<"BAILIAN_API_KEY">>},
                % qwen3.7-flash 已在该网关确认（2026-08-08）
                model => {env, <<"BAILIAN_MODEL">>, <<"qwen3.7-flash">>}
            }
            %% 本地联调用 mock LLM（无 key 也能验通 agent 对话全链）：
            %% 配套 scripts/mock_llm_server.py（OpenAI 兼容，固定应答）。
            %% 本文件不入仓（.gitignore *local*.config），仅供本机。
            , #{
                name => <<"mock">>,
                module => imboy_llm_openai,
                base_url => <<"http://127.0.0.1:9911/v1">>,
                api_key => <<"mock-key">>,
                model => <<"mock-chat-1">>
            }
            %% 智谱原生多模态（视频理解 + 文本）：墨芽 AI 回课走这条。
            %% vision 由 moya_ai_draft_logic 按 provider 条目级能力声明识别；
            %% 密钥同规走环境变量：export BIGMODEL_API_KEY=<id.secret>
            %% 模型可切换：export BIGMODEL_MODEL=<模型名>，重启节点生效（imboy_llm_registry
            %% resolve_env 支持 {env, Var, Default} 三元组），缺省 glm-5.3-flash。
            %%
            %% 选型实测（2026-09-12，同一 key 同一载荷）：
            %%   glm-5.3-flash【现用】原生多模态，输入模态含视频；¥0.8/M 入、¥2.8/M 出。
            %%     60s 回课 ≈14.4k 入 + ≈1.3k 出 ≈ ¥0.015/次。输出偶带 ```json 围栏，
            %%     moya_ai_draft_logic 的响应解码流程已脱壳。
            %%   glm-4.6v-flash【弃用】免费，但两种载荷 100% 返回 1305「访问量过大」。
            %%   glm-4.1v-thinking-flash【免费备选】可用（5/5），思维链内联在 content 里。
            %%
            %% ⚠️ 勿给 glm-5.3-flash 配 thinking 开关：该模型【始终思考】，传
            %% thinking => #{type => disabled} 或 low/high/max 一律被 400 拒绝
            %%（「该模型始终思考，不支持关闭思考」）。思考 token 计入输出计费。
            %%
            %% CogVideoX-Flash/-3 是【视频生成】模型（异步任务，见
            %% https://docs.bigmodel.cn/cn/guide/models/free/cogvideox-flash），不能用于
            %% 回课视频理解，勿配进本条目；glm-5.3-flash 亦不能生成视频（实测被拒）。
            , #{
                name => <<"bigmodel">>,
                module => imboy_llm_openai,
                base_url => <<"https://open.bigmodel.cn/api/paas/v4">>,
                api_key => {env, <<"BIGMODEL_API_KEY">>},
                model => {env, <<"BIGMODEL_MODEL">>, <<"glm-5.3-flash">>},
                vision => true,
                %% 单次请求超时（毫秒）。缺省时 imboy_llm_openai 用 30s（与 elib_req
                %% 全局默认一致）——那是**纯文本接口**够用的保守值，对「视频理解 +
                %% 始终思考」的 glm-5.3-flash 会在长尾上偶发截断：
                %% 实测成功样本 21.7s，而 30.0s 那次直接落 error_code=timeout。
                %% 60s 给到约 2.8x 余量。
                %%
                %% ⚠️ 服务端最坏路径 = 本值 × 尝试次数（moya_ai_worker
                %% ?DEFAULT_MAX_RETRIES=2，attempt 1→2 后判负）= 120s；
                %% 前端轮询预算必须 > 1.5 × 120s = 180s，见
                %% moya/src/packages/teacher/workbench/workbench.ts 顶部常量。
                %% **改本值必须同步改那边**，否则重现「前端先超时、后端还在跑」。
                timeout => 60000
            }
        ]},

        %% ── 墨芽 AI 回课管线开关（2026-09-14 本地启用） ──────────────────
        %% 以下两键须**成对启用**：provider 名 + 视频可达 URL，缺一则回课
        %% 无意义（只把 object_key 交给模型 = 内容盲）。完整说明见
        %% config/sys.config.example:294-308。
        %%
        %% ⚠️ 合规提醒：attach_video_url=true 会把每条回课的短时（600s）视频
        %% URL 交给第三方多模态模型（智谱 glm-5.3-flash），构成
        %% 「未成年人媒体内容对外数据流」。仅本机联调环境开启。
        {teaching_ai_attach_video_url, true},
        %% 指定用哪个 llm_providers 条目。密钥不落盘：bigmodel 条目的
        %% api_key => {env, <<"BIGMODEL_API_KEY">>} 在**启动时**从 OS 环境解析。
        %% 仓根 .env.local（gitignored）已存该键，scripts/start_node.sh
        %% 启动前自动加载；若直接 `IMBOYENV=local make run` 则须自行 export，
        %% 否则 resolve_provider 因 HasKey=false 仍降级 provider_unavailable。
        {teaching_ai_llm_provider, <<"bigmodel">>},
        %% 宽松 schema 校验：**仅本机联调**。素材不合格（如测试视频是桌面场景）
        %% 时模型会诚实拒答，严格校验下必然 bad_schema → 本地永远看不到终态。
        %% 打开后缺失字段回落占位值、草稿可落地（标记 needs_human_check）。
        %% 生产环境由 moya_ai_draft_logic:relaxed_schema/0 强制关闭（env=prod 恒 false）。
        {teaching_ai_relaxed_schema, true},

        % smtp 配置参考 https://github.com/gen-smtp/gen_smtp
        {smtp_option, [
            {relay, "smtp.qq.com"},
            {ssl, true},
            {auth, always},
            {trace_fun, fun io:format/2},
            {username, "leeyisoft@qq.com"},
            {password, "dkgvmerzhbpjbiif"}
        ]},

        {sms, [
            {switch, <<"off">>},
            {default_code, <<"6666">>},
            {platform, <<"aliyun">>},
            {<<"aliyun">>, [
                {sign_name, <<"xxx"/utf8>>},
                {template_code, <<"">>},
                {key_id, <<"">>},
                {key_secret, <<"">>},
                {region_id, <<"cn-shenzhen">>}
            ]}
        ]},

        {sql_driver, pgsql},
        {pg_conf, #{
            name => pgsql,
            max_count => 80,
            init_count => 5,
            start_mfa => {
                epgsql,
                connect,
                [
                    #{
                        host => "127.0.0.1",
                        username => "imboy_user",
                        password => "abc54321",
                        database => "imboy_ews_20261004T0655Z",
                        port => 4323,
                        ssl => false,
                        timeout => 4000,
                        codecs => [{epgsql_codec_rfc3339_bin, []}]
                    }
                ]
            }
        }},
        %% 能够创建表删除表的超级数据库用户
        {super_account, #{
            host => "127.0.0.1",
            username => "imboy_user",
            password => "abc54321",
            database => "imboy_ews_20261004T0655Z",
            port => 4323,
            ssl => false,
            timeout => 4000
        }},
        {scripts_path, "$PROJECT_DIR/migrations"},

        %% Depcache settings,
        {depcache, [
            % maximum size in mbs
            {depcache_memory_max, 100}
        ]},
        {redis_options, [
            {password, "abc16762996353"}, {database, 0}, {host, "127.0.0.1"}, {port, 6378}
        ]},

        %% 消息归档（集成测试 smoke test 需要）
        {msg_archive_enabled, true},

        %% Olm OTK 已消费审计行清理（默认禁用，见 ADR 03 §8.3）
        {olm_otk_cleanup_enabled, false},
        {olm_otk_cleanup_interval_ms, 86400000},
        {olm_otk_retention_days, 7},

        %% Feature flags — 显式开启所有功能
        %% https://github.com/imboy.pub/imboyapp/issues/附近的人
        {features, #{
            core => #{enabled => true},
            e2ee => #{enabled => true},
            channel => #{enabled => true},
            location => #{enabled => true},
            moment => #{enabled => true},
            channel_discover => #{enabled => true},
            channel_invitation => #{enabled => true},
            channel_order => #{enabled => true},
            group_vote => #{enabled => true},
            group_schedule => #{enabled => true},
            group_task => #{enabled => true}
        }}
    ]},

    {throttle, [
        {rates, [
            %% 本地/e2e 放宽：管理后台单页十余请求，自动化测试一轮上百请求，
            %% 默认 120/min 会把测试账号限流踢回登录页
            {api_per_user, 6000, per_minute},
            {api_per_ip, 3000, per_minute},
            {passport_per_ip, 120, per_minute},
            {refreshtoken, 11, per_minute},
            {refreshtoken, 5, per_second},
            {throttle_ws, 22, per_minute},
            {throttle_ws, 10, per_second},
            % 3 秒 1次
            {three_second_once, 1, 3000},
            {per_hour_once, 1, per_hour},
            {per_minute_once, 1, per_minute},
            {e2ee_report_key, 200, per_hour},
            {e2ee_backup, 60, per_hour},
            {e2ee_create_shards, 5, per_day},
            {e2ee_decrypt_shard, 20, per_hour},
            {e2ee_transfer, 200, per_hour},
            {olm_claim, 60, per_minute},
            {olm_claim_target, 120, per_minute}
        ]}
    ]},

    %% Lager Begin %%%
    {sasl, [
        {utc_log, true},
        {sasl_error_logger, {file, "log/sasl-error.log"}},
        {errlog_type, error},
        % Log directory
        {error_logger_mf_dir, "log/sasl"},
        % 100 MB max file size
        {error_logger_mf_maxbytes, 104857600},
        % 255 files max
        {error_logger_mf_maxfiles, 255}
    ]},
    {lager, [
        %% 日志根目录（注意：确保该目录有写入权限）
        {log_root, "./log"},
        %% What handlers to install with what arguments
        {handlers, [
            {lager_console_backend, [
                {level, info},
                {formatter, lager_default_formatter},
                {formatter_config, [
                    color, date, " ", time, " [", severity, "] ", node, "#", pid, " ", message, "\n"
                ]}
            ]},
            {lager_file_backend, [
                {file, "error.log"}, {level, error}, {size, 10485760}, {date, "$D0"}, {count, 999}
            ]},
            {lager_file_backend, [
                {file, "debug.log"}, {level, info}, {size, 10485760}, {date, "$D0"}, {count, 999}
            ]}
        ]},
        % 启用颜色
        {colored, true},
        %% 控制台日志颜色配置（仅对lager_default_formatter生效）
        {colors, [
            % 灰色
            {debug, "\e[0;38m"},
            % 绿色
            {info, "\e[1;32m"},
            % 青色
            {notice, "\e[1;36m"},
            % 黄色
            {warning, "\e[1;33m"},
            % 红色
            {error, "\e[1;31m"},
            % 紫色
            {critical, "\e[1;35m"},
            % 蓝底白字
            {alert, "\e[1;44m"},
            % 红底白字
            {emergency, "\e[1;41m"}
        ]}
    ]},
    {kernel, [
        {start_timer, true},
        {logger_level, info}
    ]},
    %% Lager End %%%

    %% ── 定时作业（ecron）────────────────────────────────────────────
    %% ⚠️ 本段此前在本机配置中**整体缺失**。ecron v1.1.0 只消费
    %% local_jobs/global_jobs，无本段时作业数为 0 且**不报错**：
    %% 教学 AI Worker / 附件清理 / 支付对账 / 红包退款全部静默不跑。
    %% 这正是「89 条 calligraphy_review_draft 恒卡 queued」的可观察后果
    %% （见 scripts/check_cron_config.sh 头部的事故记录）。
    %% 作业集与 config/sys.config.example 保持一致，由该门禁 --strict 校验。
    %%
    %% 另注：Erlang 配置注释必须用 `%` —— 模板曾因行首 `///` 非法注释符
    %% 致 file:consult 整体解析失败、全部作业失效（R6 事故）。
    {ecron, [
        %% local or utc
        {time_zone, local},
        {global_quorum_size, 1},
        %% 选 local_jobs：本仓周期作业均带幂等/守卫（AI Worker 认领 = 原子
        %% UPDATE...SKIP LOCKED，多 worker 天然安全；清理类带 age + NOT EXISTS
        %% 守卫；支付对账本身是幂等补单设计），双节点重复执行安全。
        {local_jobs, [
            %% 附件孤儿清理：每日 03:00（age_days 由 imboy env 控制，默认 30）
            {attachment_orphan_cleanup, "0 3 * * *",
                {attach_cleanup_logic, run_orphan_cleanup, []}},
            %% 待确认 presign 回收：每小时 17 分（age_hours 默认 24）
            {attachment_pending_cleanup, "17 * * * *",
                {attach_cleanup_logic, run_pending_cleanup, []}},
            %% 教学未绑定附件回收：每小时 23 分（默认 24h，下限 2）
            {teaching_unbound_cleanup, "23 * * * *",
                {moya_attach_logic, run_unbound_cleanup, []}},
            %% ★ 墨芽 AI 回课 Worker：每分钟认领一笔 queued 草稿。
            %% provider 未就绪时快速降级 failed=provider_unavailable，
            %% 老师人工队列不受影响（failed 不阻塞人工）。
            {teaching_ai_worker, "*/1 * * * *", {moya_ai_worker, run_once, []}},
            %% ★ 卡死行回收：worker 在 claim 后崩溃会遗留 running 行且永不自愈。
            %% 每 10 分钟扫一次超龄 running 回 queued（默认 900s，下限钳制 300）。
            {teaching_ai_stuck_reclaim, "*/10 * * * *",
                {moya_ai_worker, reclaim_stuck, []}},
            %% 支付对账：每小时 37 分（lookback 默认 25h，故意大于间隔防漏单）
            {payment_reconcile, "37 * * * *",
                {payment_reconcile_logic, run_hourly, []}},
            %% 红包过期退款：每小时 23 分（单轮上限默认 500）
            {red_packet_expire_refund, "23 * * * *",
                {red_packet_logic, run_expire_refund, []}},
            %% 运营周报：每周一 09:00
            {ops_weekly_report, "0 9 * * 1",
                {ops_report_logic, run_weekly_report, []}}
        ]},
        {global_jobs, []}
    ]}
].
