              'import \'package:imboy/config/payment_config.dart\';\n'
              'import \'package:imboy/service/app_logger.dart\';\n'
              'import \'package:imboy/service/payment_gateway.dart\';\n'
              '\n'
              '/// 第三方支付收银台唤起结果。\n'
              'enum PaymentLaunchResult {\n'
              '  /// 用户付款成功（前端仍须轮询订单状态确认入账）。\n'
              '  success,\n'
              '\n'
              '  /// 用户主动取消支付。\n'
              '  cancelled,\n'
              '\n'
              '  /// 支付失败（含 SDK 报错、未安装客户端、回调失败码）。\n'
              '  failed,\n'
              '\n'
              '  /// 支付方式未配置或下单参数不完整，应提示"即将开通"。\n'
              '  notConfigured,\n'
              '}\n'
              '\n'
              '/// 支付宝原生回调状态码（resultStatus）。\n'
              'abstract final class AlipayResultStatus {\n'
              '  static const String success = \'9000\';\n'
              '  static const String cancelled = \'6001\';\n'
              '}\n'
              '\n'
              '/// 微信支付回调 errCode。\n'
              'abstract final class WechatErrCode {\n'
              '  static const int success = 0;\n'
              '  static const int cancelled = -2;\n'
              '}\n'
              '\n'
              '/// 第三方支付收银台唤起器。\n'
              '///\n'
              '/// 闭环：后端统一下单返回 `pay_params` → 本类按 method 分发并唤起对应原生 SDK →\n'
              '/// 用户付款 → 返回 [PaymentLaunchResult]。调用方据结果决定是否继续轮询订单状态\n'
              '/// （`success`/`failed` 继续轮询，`cancelled` 中止，`notConfigured` 提示）。\n'
              '///\n'
              '/// SDK 调用通过可注入的 [PaymentSdkGateway] 隔离，便于单测。\n'
              'class PaymentLauncher {\n'
              '  PaymentLauncher({PaymentSdkGateway? gateway})\n'
              '    : _gateway = gateway ?? RealPaymentSdkGateway();\n'
              '\n'
              '  final PaymentSdkGateway _gateway;\n'
              '\n'
              '  /// 按支付方式分发唤起。[payParams] 为后端信封中的 `pay_params`。\n'
              '  Future<PaymentLaunchResult> launch(\n'
              '    String method,\n'
              '    Map<dynamic, dynamic>? payParams,\n'
              '  ) {\n'
              '    final params = payParams ?? const <dynamic, dynamic>{};\n'
              '    switch (method) {\n'
              '      case \'alipay\':\n'
              '        return launchAlipay(params);\n'
              '      case \'wechat\':\n'
              '        return launchWechat(params);\n'
              '      default:\n'
              '        // wallet 等无需唤起 SDK 的方式不应走到这里；未知方式视为未配置。\n'
              '        return Future.value(PaymentLaunchResult.notConfigured);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// 唤起支付宝收银台。\n'
              '  Future<PaymentLaunchResult> launchAlipay(\n'
              '    Map<dynamic, dynamic> payParams,\n'
              '  ) async {\n'
              '    if (!PaymentConfig.isAlipayConfigured) {\n'
              '      return PaymentLaunchResult.notConfigured;\n'
              '    }\n'
              '    final orderStr = _stringOf(payParams[\'order_str\']);\n'
              '    if (orderStr.isEmpty) return PaymentLaunchResult.notConfigured;\n'
              '\n'
              '    try {\n'
              '      final result = await _gateway.aliPay(\n'
              '        orderStr,\n'
              '        universalLink: _nullIfEmpty(PaymentConfig.alipayUniversalLink),\n'
              '      );\n'
              '      return parseAlipayResult(result);\n'
              '    } on Object catch (e, s) {\n'
              '      if (kDebugMode) debugPrint(\'[PaymentLauncher] alipay error: $e\');\n'
              '      AppLogger.error(\'[PaymentLauncher] alipay launch failed\', e, s);\n'
              '      return PaymentLaunchResult.failed;\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// 唤起微信收银台。\n'
              '  ///\n'
              '  /// 微信下单需 6 项二次签名参数（partnerId/prepayId/packageValue/nonceStr/\n'
              '  /// timeStamp/sign）。任一缺失视为后端二次签名未就绪 → 降级 notConfigured。\n'
              '  Future<PaymentLaunchResult> launchWechat(\n'
              '    Map<dynamic, dynamic> payParams,\n'
              '  ) async {\n'
              '    if (!PaymentConfig.isWechatConfigured) {\n'
              '      return PaymentLaunchResult.notConfigured;\n'
              '    }\n'
              '    final fields = parseWechatParams(payParams, PaymentConfig.wechatAppId);\n'
              '    if (fields == null) return PaymentLaunchResult.notConfigured;\n'
              '\n'
              '    try {\n'
              '      final registered = await _gateway.ensureWechatRegistered(\n'
              '        appId: PaymentConfig.wechatAppId,\n'
              '        universalLink: _nullIfEmpty(PaymentConfig.wechatUniversalLink),\n'
              '      );\n'
              '      if (!registered) return PaymentLaunchResult.notConfigured;\n'
              '\n'
              '      final errCode = await _gateway.wechatPay(\n'
              '        appId: fields.appId,\n'
              '        partnerId: fields.partnerId,\n'
              '        prepayId: fields.prepayId,\n'
              '        packageValue: fields.packageValue,\n'
              '        nonceStr: fields.nonceStr,\n'
              '        timestamp: fields.timestamp,\n'
              '        sign: fields.sign,\n'
              '        signType: fields.signType,\n'
              '      );\n'
              '      return parseWechatResult(errCode);\n'
              '    } on Object catch (e, s) {\n'
              '      if (kDebugMode) debugPrint(\'[PaymentLauncher] wechat error: $e\');\n'
              '      AppLogger.error(\'[PaymentLauncher] wechat launch failed\', e, s);\n'
              '      return PaymentLaunchResult.failed;\n'
              '    }\n'
              '  }\n'
              '\n'
              '  // ── 纯逻辑（可单测，不触碰 SDK）───────────────────────────────────────\n'
              '\n'
              '  /// 解析支付宝回调 Map 的 `resultStatus`。\n'
              '  static PaymentLaunchResult parseAlipayResult(Map<dynamic, dynamic> result) {\n'
              '    final status = _stringOf(result[\'resultStatus\']);\n'
              '    return switch (status) {\n'
              '      AlipayResultStatus.success => PaymentLaunchResult.success,\n'
              '      AlipayResultStatus.cancelled => PaymentLaunchResult.cancelled,\n'
              '      _ => PaymentLaunchResult.failed,\n'
              '    };\n'
              '  }\n'
              '\n'
              '  /// 解析微信回调 errCode。\n'
              '  static PaymentLaunchResult parseWechatResult(int? errCode) {\n'
              '    return switch (errCode) {\n'
              '      WechatErrCode.success => PaymentLaunchResult.success,\n'
              '      WechatErrCode.cancelled => PaymentLaunchResult.cancelled,\n'
              '      _ => PaymentLaunchResult.failed,\n'
              '    };\n'
              '  }\n'
              '\n'
              '  /// 校验并提取微信下单参数；缺任一必要字段返回 `null`（→ notConfigured 降级）。\n'
              '  ///\n'
              '  /// appId 优先用后端下发，缺失时回落到编译期配置 [configAppId]。\n'
              '  static WechatPayFields? parseWechatParams(\n'
              '    Map<dynamic, dynamic> payParams,\n'
              '    String configAppId,\n'
              '  ) {\n'
              '    final appId = _firstNonEmpty(_stringOf(payParams[\'appid\']), configAppId);\n'
              '    final partnerId = _stringOf(payParams[\'partnerid\']);\n'
              '    final prepayId = _stringOf(payParams[\'prepay_id\'] ?? payParams[\'prepayid\']);\n'
              '    final packageValue = _firstNonEmpty(\n'
              '      _stringOf(payParams[\'package\']),\n'
              '      \'Sign=WXPay\',\n'
              '    );\n'
              '    final nonceStr = _stringOf(payParams[\'noncestr\'] ?? payParams[\'nonce_str\']);\n'
              '    final sign = _stringOf(payParams[\'sign\']);\n'
              '    final timestamp = _intOf(\n'
              '      payParams[\'timestamp\'] ??\n'
              '          payParams[\'timeStamp\'] ??\n'
              '          payParams[\'time_stamp\'],\n'
              '    );\n'
              '\n'
              '    if (appId.isEmpty ||\n'
              '        partnerId.isEmpty ||\n'
              '        prepayId.isEmpty ||\n'
              '        nonceStr.isEmpty ||\n'
              '        sign.isEmpty ||\n'
              '        timestamp <= 0) {\n'
              '      return null;\n'
              '    }\n'
              '    return WechatPayFields(\n'
              '      appId: appId,\n'
              '      partnerId: partnerId,\n'
              '      prepayId: prepayId,\n'
              '      packageValue: packageValue,\n'
              '      nonceStr: nonceStr,\n'
              '      timestamp: timestamp,\n'
              '      sign: sign,\n'
              '      signType: _nullIfEmpty(_stringOf(payParams[\'signtype\'])),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static String _stringOf(Object? v) => v?.toString() ?? \'\';\n'
              '\n'
              '  static String? _nullIfEmpty(String v) => v.isEmpty ? null : v;\n'
              '\n'
              '  static String _firstNonEmpty(String a, String b) => a.isNotEmpty ? a : b;\n'
              '\n'
              '  static int _intOf(Object? v) {\n'
              '    if (v is int) return v;\n'
              '    if (v is num) return v.toInt();\n'
              '    return int.tryParse(v?.toString() ?? \'\') ?? 0;\n'
              '  }\n'
              '}\n'
              '\n'
