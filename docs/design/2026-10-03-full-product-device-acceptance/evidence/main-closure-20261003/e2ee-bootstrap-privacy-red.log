              '        impl.debugMarkReadyForTest(uid);\n'
              '      }\n'
              '    }\n'
              '    _initializedUid = uid;\n'
              '  }\n'
              '\n'
              '  /// 仅测试用：重置引导标志 + 清空注册表。\n'
