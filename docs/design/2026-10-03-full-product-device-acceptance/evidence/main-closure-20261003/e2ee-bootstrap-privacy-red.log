              '        s.cancel();\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// 已完成 [E2eeSessionProtocol.initialize] 的用户；换账号时需重新初始化。\n'
              '  static String? _initializedUid;\n'
              '\n'
              '  /// 注册 **并** 初始化三套件（BUG#72）。\n'
              '  ///\n'
              '  /// `initialize` 此前在整个项目里**零调用点**——三个实现都写好了，但没人调。\n'
              '  /// 后果是 `OlmProtocol._selfUid` 永远为 null，一旦服务端把\n'
              '  /// `e2ee_mode` 打开，第一条单聊消息就抛\n'
              '  /// `Bad state: OlmProtocol not initialized (missing self uid)`，\n'
              '  /// 全站单聊直接不可用（2026-08-04 生产实测）。\n'
              '  ///\n'
              '  /// 幂等：同一 uid 只初始化一次；换账号（uid 变化）会重新初始化。\n'
              '  static Future<void> ensureReady() async {\n'
              '    ensureRegistered();\n'
              '    // AC-15：协议引导的同时安装信任生命周期常驻接线（幂等）。\n'
              '    unawaitedFn(Future.sync(ensureTrustWiring));\n'
              '\n'
              '    final String uid = UserRepoLocal.to.currentUid;\n'
              '    if (uid.isEmpty) return; // 未登录：没有身份可初始化，留给登录后再调\n'
              '    if (_initializedUid == uid) return;\n'
              '\n'
              '    final String deviceId = await DeviceExt.did;\n'
              '    for (final impl in E2eeProtocolRegistry.registered()) {\n'
              '      try {\n'
              '        await impl.initialize(userId: uid, deviceId: deviceId);\n'
              '      } on Object catch (e) {\n'
              '        // 单个套件初始化失败不应拖垮其它套件（如 Megolm 失败不该挡住 Olm）；\n'
              '        // 真正的失败会在 encrypt 时以明确异常暴露，这里只留痕。\n'
              '        debugPrint(\n'
              '          \'[E2eeBootstrap] initialize ${impl.suite.protocol} failed: $e\',\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '    _initializedUid = uid;\n'
              '  }\n'
              '\n'
              '  /// 仅测试用：标记指定用户已完成协议初始化，避免平台集成测试触发网络注册。\n'
              '  ///\n'
              '  /// 这只跳过 Olm identity 的远端注册，不替代协议注册；需要实际验证 Olm\n'
