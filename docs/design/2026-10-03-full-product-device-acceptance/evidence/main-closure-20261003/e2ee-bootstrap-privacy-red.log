              'import \'package:imboy/service/e2ee/megolm_protocol.dart\';\n'
              'import \'package:imboy/service/e2ee/olm_protocol.dart\';\n'
              'import \'package:imboy/service/e2ee/rsa_legacy_protocol.dart\';\n'
              'import \'package:imboy/service/events/events.dart\';\n'
              'import \'package:imboy/service/safety_number_service.dart\';\n'
              '\n'
              'class E2eeBootstrap {\n'
              '  const E2eeBootstrap._();\n'
              '\n'
              '  static bool _registered = false;\n'
              '\n'
              '  /// AC-15 信任生命周期常驻接线的安装标志。\n'
              '  static bool _trustWiringInstalled = false;\n'
              '  static List<StreamSubscription<void>>? _trustSubscriptions;\n'
              '\n'
              '  /// 幂等注册 olm / megolm / rsa-oaep 三套件。重复调用无副作用。\n'
              '  static void ensureRegistered() {\n'
              '    if (_registered) return;\n'
              '    E2eeProtocolRegistry.register(OlmProtocol());\n'
              '    E2eeProtocolRegistry.register(MegolmProtocol());\n'
              '    E2eeProtocolRegistry.register(RsaLegacyProtocol()); // 仅 decrypt\n'
              '    _registered = true;\n'
              '  }\n'
              '\n'
              '  /// AC-15：安装信任生命周期常驻订阅（幂等）。\n'
              '  ///\n'
              '  /// 对端身份换钥 / 信任撤销的 S2C 事件在 `message_s2c` 已被转换为\n'
              '  /// AppEventBus 事件（E2EEPeerKeyChangedEvent / E2EETrustChangedEvent），\n'
              '  /// 并完成密钥缓存清理与 Olm 会话驱逐；本接线补上**本地安全码信任标记**\n'
              '  /// 的同步失效——否则「已验证」标记会在换钥后静默沿用（C01 后端\n'
              '  /// identity_version 推进 → 客户端本地信任必须跟着过期）。\n'
              '  static Future<void> ensureTrustWiring() async {\n'
              '    if (_trustWiringInstalled) return;\n'
              '    _trustWiringInstalled = true;\n'
              '\n'
              '    final subs = <StreamSubscription<void>>[];\n'
              '\n'
              '    // 换钥（e2ee_key_changed）：对端某设备 identity key 变更。\n'
              '    // 语义：该 peer 的聚合安全码必然变化，旧「已验证」立即失效。\n'
              '    subs.add(\n'
              '      AppEventBus.on<E2EEPeerKeyChangedEvent>().listen((event) {\n'
              '        unawaitedFn(\n'
              '          SafetyNumberService.invalidateTrust(event.uid, \'peer_key_changed\'),\n'
              '        );\n'
              '      }),\n'
              '    );\n'
              '\n'
              '    // 信任撤销（e2ee_trust_changed → revoked/unverified）：只有本机是\n'
              '    // actor、目标是其他用户时，本地对该 peer 的验证标记才随之失效\n'
              '    // （与 message_s2c._handleE2EETrustChanged 的驱逐范围判定一致）。\n'
              '    subs.add(\n'
              '      AppEventBus.on<E2EETrustChangedEvent>().listen((event) {\n'
              '        if (event.toState == \'verified\') return;\n'
              '        final currentUid = _currentUidOrEmpty();\n'
              '        if (currentUid.isEmpty) return;\n'
              '        if (event.actorUid == currentUid && event.targetUid != currentUid) {\n'
              '          unawaitedFn(\n'
              '            SafetyNumberService.invalidateTrust(\n'
              '              event.targetUid,\n'
              '              \'trust_${event.toState}\',\n'
              '            ),\n'
              '          );\n'
              '        }\n'
              '      }),\n'
              '    );\n'
              '\n'
              '    _trustSubscriptions = subs;\n'
              '  }\n'
              '\n'
              '  static String _currentUidOrEmpty() {\n'
              '    try {\n'
              '      return UserRepoLocal.to.currentUid;\n'
              '    } on Object {\n'
              '      return \'\';\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// fire-and-forget 辅助：后台信任失效失败只留痕，不打断事件流。\n'
              '  static void unawaitedFn(Future<void> future) {\n'
              '    future.catchError((Object e) {\n'
              '      debugPrint(\'[E2eeBootstrap] trust invalidation failed: $e\');\n'
              '    });\n'
              '  }\n'
              '\n'
              '  /// 仅测试用：拆除信任接线订阅。\n'
