  "recommendations": [
    {
      "id": "R01",
      "decision": "接受",
      "section": "§1.6/第3节/§8.4",
      "basis": "三仓 origin/main 实测；ADM 路由/DTO/归档/权限消费者独立；F07/08/09/16 默认分支与 WIP 分列，Admin 无无条件必改代码。"
    },
    {
      "id": "R02",
      "decision": "调整后接受",
      "section": "§6.4/§10.4",
      "basis": "现有 manifest 无 contracts map；在既有顶层增对象字段，区分群/频道/偏好/水位，合同 ETag 与编译 hash 不混用，明确禁止剥键。"
    },
    {
      "id": "R03",
      "decision": "调整后接受",
      "section": "§6.4 恢复及边界表",
      "basis": "24h 客户端派发、7d 服务端响应不是同一时钟；recover_only 复用 POST 只查，receipt 不因过期重置。"
    },
    {
      "id": "R04",
      "decision": "接受",
      "section": "§6.4/W04.b/c/J23",
      "basis": "已有资源事务和 after_commit，但后者仅缓存失效且不持久；通知复用 msg_s2c 持久链，新增 Conn 入口若必要只限该链。"
    },
    {
      "id": "R05",
      "decision": "调整后接受",
      "section": "§6.8/J13",
      "basis": "当前 mark_as_read 忽略 message_id；既有时间/TSID 不证明提交序，限定最小频道 update_seq/view_seq，不做逐帖阅读系统。"
    },
    {
      "id": "R06",
      "decision": "接受",
      "section": "§6.6/J29",
      "basis": "原“当前上下文读取”过宽，改内容授权 K、20s提前验/30s硬截止及三层缓存，不造服务器租约。"
    },
    {
      "id": "R07",
      "decision": "调整后接受",
      "section": "§6.5/W07/J20",
      "basis": "订阅 id 实际存在且重激活复用；工作区成员列表是 /groups?member_only=1，不虚构 member-groups 路由；完整搜索分四类。"
    },
    {
      "id": "R08",
      "decision": "接受",
      "section": "§6.5 权威范围表/J26",
      "basis": "当前 summary 无集合完整性证明；缺席≠0，完成翻页仍不得无条件清理，显式对象状态才可销账。"
    },
    {
      "id": "R09",
      "decision": "调整后接受",
      "section": "§6.7/W09/J16/17/28",
      "basis": "单聊SQLite、群KV＋投影、频道本机订阅、服务端pin/delete分别核对；不把群禁言当免打扰，不造workspace世代。；已确认群KV无账号前缀，需最小范围键与所有直接消费者一起修复。"
    },
    {
      "id": "R10",
      "decision": "接受，修复条件化",
      "section": "§10.3/J27.d/e",
      "basis": "Admin有解码前保护，App默认Dio+num转字符串无法证明Web精度；固定raw-wire测试，未经失败证据不全仓改ID。"
    },
    {
      "id": "R11",
      "decision": "接受",
      "section": "§8.2开发DAG/联合启用/F11",
      "basis": "开发前置、文件串行与启用分别列；W07不等整个W04，W10开发不等整个W09。"
    },
    {
      "id": "R12",
      "decision": "接受",
      "section": "§8.2子卡",
      "basis": "W04/W07/W09落14个子节点（含App群/频道分别接入），明确路径/禁区/测试/退出/回退，未新增任务平台。"
    },
    {
      "id": "R13",
      "decision": "接受",
      "section": "§9断言表",
      "basis": "所有J都有固定子断言，J18/J22/J28/J29分拆；Required/条件适用、拟扩展测试和NOT_RUN逐行记录。"
    },
    {
      "id": "R14",
      "decision": "调整后接受",
      "section": "§10.4/J28",
      "basis": "当前单节点manifest不代表集群；明确新合同不支持新旧Backend混跑，兼容全节点部署后才启用；Admin纳入回归。"
    },
    {
      "id": "R15",
      "decision": "接受",
      "section": "§8.4",
      "basis": "按三仓真实Makefile/CI/脚本核入口，保存ratchet与裸分析、覆盖阈值和默认排除集的差别，本轮不执行业务门。"
    },
    {
      "id": "R16",
      "decision": "接受",
      "section": "§1.6/§11.1",
      "basis": "沿用原worktree/HEAD，静态证据不当运行引擎；WIP指纹保护、历史局部收据与当前完整验收分离，唯一V2.2入口。"
    }
  ],
