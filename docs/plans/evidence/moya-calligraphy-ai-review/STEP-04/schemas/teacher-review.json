{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imboy.pub/schemas/moya/step4/teacher-review.json",
  "title": "TeacherReview",
  "description": "墨芽 Step 4 冻结：teacher_review 资源表示（draft/published/discarded）。reviewer_uid / status / published_at 为服务端权威字段，客户端提交即拒（5484）。",
  "type": "object",
  "required": ["review_id", "submission_id", "reviewer_uid", "status"],
  "additionalProperties": false,
  "properties": {
    "review_id": { "$ref": "#/$defs/tsidString" },
    "submission_id": { "$ref": "#/$defs/tsidString" },
    "reviewer_uid": {
      "allOf": [{ "$ref": "#/$defs/tsidString" }],
      "description": "服务端写入（=当前 JWT uid）。published 后不可变；客户端伪造 → 5484。"
    },
    "positive_point": { "type": "string", "maxLength": 200 },
    "focus_problem": { "type": "string", "maxLength": 200 },
    "practice_action": { "type": "string", "maxLength": 200 },
    "comment": { "type": "string", "maxLength": 1000 },
    "video_attachment_id": {
      "anyOf": [{ "$ref": "#/$defs/tsidString" }, { "type": "null" }],
      "description": "真人点评视频附件（老师本人 confirm）。可空。"
    },
    "rework_required": { "type": "boolean", "default": false },
    "status": { "enum": ["draft", "published", "discarded"] },
    "published_at": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
      "description": "仅 status=published 时非空；由服务端在 draft→published 条件更新事务内设置。"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "tsidString": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "TSID/64-bit ID 的 JSON 表达（API-01）。"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" } } },
      "then": {
        "required": ["published_at"],
        "properties": { "published_at": { "type": "string", "format": "date-time" } }
      }
    }
  ],
  "examples": [
    {
      "review_id": "6214747500760321",
      "submission_id": "6214747500760300",
      "reviewer_uid": "1000000000000001",
      "positive_point": "横画起笔稳",
      "focus_problem": "竖画歪斜",
      "practice_action": "每天慢写三行竖画",
      "comment": "",
      "video_attachment_id": "7036874417766999",
      "rework_required": false,
      "status": "published",
      "published_at": "2026-09-09T10:01:00Z",
      "created_at": "2026-09-09T09:55:00Z",
      "updated_at": "2026-09-09T10:01:00Z"
    }
  ]
}
