%% ===================================================================
%% IMBoy Plugin Manifest — example (教学样板 / Tutorial template)
%%
%% 用途 / Purpose:
%%   第三方插件作者参考样板，演示 contract.md v1.0 的全部字段用法。
%%   Reference template for third-party plugin authors, demonstrating
%%   all fields of contract.md v1.0.
%%
%% 位置 / Location:
%%   `priv/plugin-examples/example/plugin.config` —— **不**在生产
%%   `priv/plugins/` 目录下，所以**不会**被 imboy_plugin_loader 默认加载。
%%   测试或学习时手动指定路径加载：
%%     imboy_plugin_loader:start_link("priv/plugin-examples").
%%
%% Source of truth: docs/plugin/contract.md
%% Contract version: 1.0
%% ===================================================================

#{
    %% ----- 必填基础字段 / Required basics --------------------------

    %% 插件名（snake_case，全集群唯一，3..32 字符）
    %% Plugin name (snake_case, cluster-unique, 3..32 chars)
    name => example,

    %% 插件版本（严格 semver 2.0）
    %% Plugin version (strict semver 2.0)
    version => <<"0.1.0">>,

    %% 契约版本（声明本插件兼容 imboy_plugin behaviour 的哪个版本）
    %% Contract version (which imboy_plugin behaviour version this targets)
    %% 当前 core 仅支持 {1, 0}；变更需先升级 core
    contract_version => {1, 0},

    %% 类型 / Kind
    %% - plugin: 标准独立插件
    %% - aggregate_plugin: 聚合插件，含子插件（如 group_collab）
    kind => plugin,

    %% 一句话描述（中文为主）
    description => <<"示例插件 / Example plugin (tutorial)"/utf8>>,

    %% ----- 依赖 / Dependencies ------------------------------------

    %% 依赖的其他插件（拓扑排序解析；当前 Phase 0 仅支持 ^X.Y.Z 与精确版本）
    %% Other plugins this depends on
    %% 例 / Example:
    %%   #{moment => <<"^1.0">>}
    depends_on => #{},

    %% 依赖的 core 能力（capability，由 core 提供并版本化）
    %% Required core capabilities
    %% 标准 capabilities：
    %%   <<"imboy.cache@1">>     — 缓存
    %%   <<"imboy.syn@1">>       — 分布式注册
    %%   <<"imboy.tsid@1">>      — 分布式 ID
    %%   <<"imboy.ws_push@2">>   — WebSocket 推送
    %%   <<"imboy.msg_seq@1">>   — conv_seq 严格顺序（消息时间线必用）
    requires_capabilities => [
        <<"imboy.cache@1">>,
        <<"imboy.tsid@1">>
    ],

    %% 最低 core 版本
    min_core_version => <<"1.0.0-rc.2">>,

    %% ----- 子插件（仅 aggregate_plugin 使用）/ Children ------------

    children => [],

    %% ----- 路由 / Routes ------------------------------------------

    %% 路由强约束（contract.md §3.3）：
    %%   path 必须以 /v{n}/<plugin_name>/ 开头（n=1|2|...）
    %%   违反则 loader 拒绝加载并记录 invalid_route_namespace 错误
    %% Hard constraint: path MUST start with /v{n}/<plugin_name>/
    routes => [
        #{
            method => <<"GET">>,
            path => <<"/v1/example/items">>,
            handler => example_handler,
            action => list_items,
            required_feature => example
        },
        #{
            method => <<"POST">>,
            path => <<"/v1/example/items">>,
            handler => example_handler,
            action => create_item,
            required_feature => example_create
        }
    ],

    %% ----- 数据库迁移 / Migrations --------------------------------

    migrations => #{
        %% 迁移文件目录（相对插件根，从 plugin.config 所在位置算起）
        dir => <<"priv/migrations">>,
        %% 表名前缀强约束：必须等于 name + "_"
        %% Hard constraint: MUST equal <name>_
        table_prefix => <<"example_">>,
        %% 卸载时是否保留数据（默认 true）
        preserve_on_uninstall => true
    },

    %% ----- 特性开关 / Feature flags（含灰度）---------------------

    %% rollout 取值 / values:
    %%   always:     无条件启用
    %%   percentage: 按百分比启用（配合 percentage 字段 0..100）
    %%   canary:     金丝雀，配合 audience 精确指定
    %%
    %% audience 取值 / values:
    %%   #{kind => all}                                — 全部用户
    %%   #{kind => tenant, tenant_ids => [...]}         — 指定租户
    %%   #{kind => uid_hash, buckets => [0..99 list]}   — uid mod 100 桶（最多 100 个）
    features => #{
        example => #{
            default => true,
            description => <<"示例基础功能"/utf8>>,
            rollout => always,
            audience => #{kind => all}
        },
        example_create => #{
            default => true,
            description => <<"示例创建功能"/utf8>>,
            rollout => percentage,
            percentage => 100,
            audience => #{kind => all}
        },
        example_experimental => #{
            %% 教学：金丝雀灰度示例（仅 5% 用户启用）
            default => false,
            description => <<"实验功能（金丝雀）"/utf8>>,
            rollout => canary,
            audience => #{kind => uid_hash, buckets => [0, 1, 2, 3, 4]}
        }
    },

    %% ----- 限流与配额 / Limits（Phase 4 实现语义）---------------

    limits => #{
        rps_per_uid => 100,            % 每用户每秒请求数（0=不限）
        max_concurrent_calls => 1000,  % 同时进行的 capability call 数
        msg_quota_per_day => 0         % 每用户每天消息配额（0=不限）
    },

    %% ----- 资源预算 / Budget（Phase 1 监督树软限）---------------

    budget => #{
        max_connections => 0,          % TCP 连接数（0=不限）
        max_subscriptions => 10000,    % syn group 订阅数
        mem_mb_soft_limit => 128       % 内存软限 MB（超限触发指标告警，不 kill）
    },

    %% ----- 降级与熔断 / Degrade and circuit breaker --------------

    degrade => #{
        %% 当 health=unhealthy 时的处置 / Behavior on unhealthy:
        %%   isolate:      路由 404（强隔离）
        %%   route_404:    返回 404（默认）
        %%   pass_through: 照旧（依赖调用方处理）
        on_unhealthy => route_404
    },

    circuit_breaker => #{
        %% 教学：启用熔断器示例
        enabled => true,
        threshold_pct => 50,           % 60s 内失败率超 50% 触发
        window_sec => 60
    },

    %% ----- 客户端入口 / Client entries ---------------------------

    %% 与 imboyapp（Flutter）+ imboy-admin-frontend（Vue）的 PluginRegistry 对应。
    %% Phase 5 兑现：客户端按 manifest 动态显示/隐藏入口。
    entries => #{
        app => [example_tab, example_detail_page],
        admin => [example_manage_page]
    },

    %% ----- 国际化 / i18n（Phase 5 兑现）-------------------------

    i18n => #{
        keys => [
            <<"example.tab.title">>,
            <<"example.empty.placeholder">>,
            <<"example.create.button">>
        ]
    },

    %% ----- 通信契约 / Communication ------------------------------

    %% 订阅的事件主题（imboy_plugin_bus）
    %% Topics this plugin subscribes to
    subscribes => [
        <<"user.deleted">>,
        <<"channel.subscribed">>
    ],

    %% 发布的事件主题
    %% Topics this plugin publishes (must declare ALL topics published)
    publishes => [
        <<"example.item_created">>,
        <<"example.item_deleted">>
    ],

    %% 主题元数据（Phase 4 兑现）
    %% Topic metadata: declare which topics carry client-decrypted E2EE plaintext
    publishes_meta => #{
        %% 教学：若主题承载客户端解密后明文，必须声明
        %% Example: when a topic carries client-decrypted E2EE plaintext
        %% <<"example.body_decrypted">> => #{
        %%     e2ee_passthrough => true,
        %%     requires_user_consent => true
        %% }
    },

    %% ----- 审计日志 / Audit log（Phase 4 兑现）------------------

    audit => #{
        %% events 必须是 publishes 子集
        events => [
            <<"example.item_created">>,
            <<"example.item_deleted">>
        ]
    },

    %% ----- 元信息 / Metadata -------------------------------------

    meta => #{
        author => <<"imboy-pub">>,
        license => <<"Apache-2.0">>,
        homepage => <<"https://gitee.com/imboy-pub/imboy">>,
        created_at => <<"2026-04-29">>,
        notes => <<"教学样板 / Tutorial only - not loaded in production"/utf8>>
    }
}.
