[
 {imboy, [
   {moderation_detector, [
     {transport, legacy},
     {http_base_url, <<"http://127.0.0.1:8787">>},
     {publish_http_base_url, <<"http://127.0.0.1:8789">>},
     {grpc_host, <<"127.0.0.1">>}, {grpc_port, 8788},
     {grpc_channel, textguard}, {timeout_ms, 150},
     {max_response_bytes, 262144}
   ]}
 ]},
 {grpcbox, [{client, #{channels => [
   {textguard, [{http, "127.0.0.1", 8788, []}], #{sync_start => true}}
 ]}}]}
].
