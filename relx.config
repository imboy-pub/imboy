%%% Imboy release definition (single source of truth).
%%%
%%% 历史上曾经按 IMBOYENV 拆出 relx.local.config / relxlocal.config /
%%% relxdev.config / relxpro.config 等多个版本，且其中两个引用了已不存在的
%%% sys.pro.config / vm.dev.args / vm.pro.args，长期 broken。
%%%
%%% 现在统一到本文件：
%%%   * release 名 / 版本号 / 打包形态：唯一真源在这里。erlang.mk 直接将本文件
%%%     传给 relx，不会解释 RELX_INCLUDE_ERTS / RELX_DEV_MODE 环境变量，因此
%%%     自包含运行时必须在此显式声明。
%%%   * 环境差异（本地 / 开发 / 生产）走运行时：
%%%       - sys.config 由 imboy_env.erl 用 IMBOY_* 环境变量在 application
%%%         启动期覆盖
%%%       - vm.args 由部署脚本（script/deploy.sh / script/start_node.sh）
%%%         在 release 目录中重写，注入节点名 / cookie / port

%% 注意：版本号必须与 VERSION / Makefile PROJECT_VERSION 保持一致。
%% RELX_REL_VSN 环境变量实测不生效（erlang.mk 直接传本文件给 relx）；
%% 部署时 scripts/lib/blue_green_deploy.sh 会在构建前把此版本行
%% 自动 sed 对齐到 .env.deploy 的 DEPLOY_VSN，本地无需手工同步。
{release, {imboy, "1.0.0-alpha.77"}, [
    imboy
    , sasl, runtime_tools, mnesia
    %% observer/wx 是开发图形工具，不进入 headless 生产 release。
]}.

%% 发布物必须自包含：运行镜像和私有化部署机均不要求另装 Erlang/OTP。
{dev_mode, false}.
{include_erts, true}.
{extended_start_script, true}.
{sys_config, "config/sys.runtime.config"}.
{vm_args, "config/vm.args"}.
