# ============================================================
# 宿主机运维作业环境变量 / Host-side ops job environment
# ------------------------------------------------------------
# 部署位置：/etc/imboy/ops.env（chmod 600，root 拥有）
# 被 deploy/cron/imboy-ops.cron 里的每条作业 `source` 后执行。
#
# 复制并按实际情况修改：
#   sudo install -m 600 deploy/ops.env.example /etc/imboy/ops.env
# ============================================================

# Pushgateway 接收端（B-23）。备份/TLS 检查是短命 cron 作业，没有常驻端点供
# Prometheus 抓取，只能把结果推上来。
# ⚠️ 必须是 127.0.0.1 —— cron 跑在宿主机上，解析不到 compose 网络里的服务名；
#    docker-compose.prod.yml 把 pushgateway 绑在 127.0.0.1:9091。
# 留空则脚本静默跳过推送（本地开发不强制依赖 Pushgateway）。
PUSHGATEWAY_URL=http://127.0.0.1:9091

# 单次推送超时（秒）。推送失败只告警不中断作业——备份本身成功时，
# 不能因为监控侧不可用就判定备份失败。
PUSH_TIMEOUT_SEC=10

# TLS 证书到期检查的域名列表（空格分隔）
IMBOY_TLS_DOMAINS="im.example.com"

# 备份产物目录（需存在且可写）
BACKUP_DIR=/var/backups/imboy
