# IMBoy 生产部署环境变量
# 复制为 .env 并填入真实值。.env 文件切勿提交到 Git。
#
#   cp .env.example .env
#   $EDITOR .env
#
# 生成 32 字节随机密钥的命令：
#   openssl rand -hex 16
#   或：python3 -c "import secrets; print(secrets.token_hex(16))"

# ---------- 版本 ----------
# 单一版本来源：与 imboy/VERSION 保持一致
IMBOY_VERSION=1.0.0-rc.1

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 域名（必须改）----------
# 后端 API + WebSocket 域名，例如 api.example.com
API_DOMAIN=api.example.com
# 管理后台域名，例如 admin.example.com
ADMIN_DOMAIN=admin.example.com

# ---------- 数据持久化根目录 ----------
# 建议使用独立数据盘，避免和系统盘混用
DATA_DIR=./data

# ---------- PostgreSQL ----------
POSTGRES_USER=imboy_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=imboy_pro
# 仅在需要从宿主机直连 PG 时暴露（建议生产关闭：设为 127.0.0.1:5432）
PG_PORT=5432
PG_MEM_LIMIT=4096M
PG_IMAGE=imboy/pg18:3.6.1-2

# ---------- 后端 imboy ----------
# 镜像默认 imboy/imboy-backend:${IMBOY_VERSION}（由 compose 内插值，单一版本来源）
# 如需自定义仓库/标签，取消下行注释覆盖：
# BACKEND_IMAGE=ghcr.io/your-org/imboy-backend:1.0.0-rc.1
BACKEND_PORT=9800
BACKEND_MEM_LIMIT=8192M
# 版次：community（默认）| professional | enterprise
# professional/enterprise 功能由商业授权的闭源模块提供；社区版此处仅作启动标记
IMBOY_EDITION=community

# ── 核心密钥（全部必须改，任意留空会导致启动 fail-fast）──────────────────────
# 生成 32 字节随机字符串：openssl rand -base64 32
JWT_KEY=CHANGE_ME_WITH_32_BYTES_SECRET__
POSTGRE_AES_KEY=CHANGE_ME_WITH_32_BYTES_SECRET__
ADM_COOKIE_SECRET=CHANGE_ME_ADM_COOKIE_SECRET____

# 客户端 init 握手加密密钥（AES-256-CBC）
# 32 字节：openssl rand -base64 32
# 16 字节 IV：openssl rand -base64 12
IMBOY_SOLIDIFIED_KEY=CHANGE_ME_32_BYTES_SOLIDIFIED_KEY_
IMBOY_SOLIDIFIED_KEY_IV=CHANGE_ME_16_BYTES_

# 生产环境必须开启 API 认证（设为 on，否则启动拒绝）
IMBOY_API_AUTH_SWITCH=on

# ── RSA 登录密钥（PEM 文件路径，容器内路径）──────────────────────────────────
# 生成方式：
#   openssl genrsa -out ./data/keys/login_rsa_priv.pem 2048
#   openssl rsa -in ./data/keys/login_rsa_priv.pem -pubout \
#           -out ./data/keys/login_rsa_pub.pem
# 然后将 ./data/keys/ 挂载到容器（compose 已配置 backend_priv 卷）
IMBOY_LOGIN_RSA_PUB_KEY_FILE=/opt/imboy/priv_runtime/keys/login_rsa_pub.pem
IMBOY_LOGIN_RSA_PRIV_KEY_FILE=/opt/imboy/priv_runtime/keys/login_rsa_priv.pem

# ── Garage S3 附件存储（必填，否则文件上传失败）─────────────────────────────
# 本地 Garage：http://127.0.0.1:3900
# Cloudflare R2：https://<ACCOUNT_ID>.r2.cloudflarestorage.com
IMBOY_GARAGE_ENDPOINT=http://garage:3900
IMBOY_GARAGE_BUCKET=imboy
IMBOY_GARAGE_ACCESS_KEY=CHANGE_ME_GARAGE_ACCESS_KEY
IMBOY_GARAGE_SECRET_KEY=CHANGE_ME_GARAGE_SECRET_KEY

# ── 短信验证码（可选；sms.switch=on 时必填）──────────────────────────────────
# 平台：yjsms | aliyun
# IMBOY_SMS_PLATFORM=yjsms
# IMBOY_YJSMS_ACCOUNT=
# IMBOY_YJSMS_SECRET=

# 可选：Sentry 监控
SENTRY_DSN=

# ---------- 管理后台 ----------
# 镜像默认 imboy/imboy-admin:${IMBOY_VERSION}（由 compose 内插值）
# 如需自定义仓库/标签，取消下行注释覆盖：
# ADMIN_IMAGE=ghcr.io/your-org/imboy-admin:1.0.0-rc.1

# ---------- Grafana 可观测性仪表盘 ----------
# 登录地址：http://<server-ip>:3000  用户名 admin
# Dashboard URL: http://<server-ip>:3000  username: admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3000

# ─────────────────────────────────────────────────────────────────────
# 支付配置 / Payment Configuration
#
# 上线前检查清单 / Pre-launch checklist:
#   1. 将 IMBOY_PAYMENT_MODE 改为 live
#   2. 填入至少一个网关的完整凭据
#   3. 在支付平台后台配置回调 URL（必须 HTTPS）
# ─────────────────────────────────────────────────────────────────────

# 支付模式：sandbox（默认，回调直通不验签，供联调测试）| live（真实验签/扣款）
# Payment mode: sandbox (default, pass-through for integration testing) | live (real verification)
IMBOY_PAYMENT_MODE=sandbox

# ─── 微信支付 APIv3 / WeChat Pay APIv3 ───
# 启用微信支付时必填；live 模式缺任意一项，则微信回调一律返回 {error, no_credential}
# Required when using WeChat Pay; missing any field in live mode rejects all WeChat callbacks
IMBOY_WECHAT_MCH_ID=
IMBOY_WECHAT_APP_ID=
IMBOY_WECHAT_API_V3_KEY=
IMBOY_WECHAT_CERT_SERIAL=
# PEM 格式私钥，多行请用引号包裹：IMBOY_WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
IMBOY_WECHAT_PRIVATE_KEY=
IMBOY_WECHAT_PLATFORM_PUBLIC_KEY=
# 微信回调地址（必须 HTTPS），例：https://api.example.com/v1/payment/callback/wechat
IMBOY_WECHAT_NOTIFY_URL=

# ─── 支付宝 / Alipay ───
IMBOY_ALIPAY_APP_ID=
# RSA2 应用私钥（PKCS#8 格式）
IMBOY_ALIPAY_PRIVATE_KEY=
# 支付宝公钥（用于验签）
IMBOY_ALIPAY_PUBLIC_KEY=
# 例：https://api.example.com/v1/payment/callback/alipay
IMBOY_ALIPAY_NOTIFY_URL=

# ─── Stripe ───
# sk_live_... 格式（沙箱用 sk_test_...，但同时需要 IMBOY_PAYMENT_MODE=sandbox）
IMBOY_STRIPE_SECRET_KEY=
# 在 Stripe Dashboard → Webhooks → 签名密钥（whsec_...）
IMBOY_STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# License 授权 / License Authorization
#
# 社区版（community）无需 License 文件。
# professional / enterprise 版必须配置，否则回退社区版配额限制。
# Community edition does not need a license file.
# Professional/Enterprise edition requires this; missing = community limits apply.
# ─────────────────────────────────────────────────────────────────────

# License 文件绝对路径，例：/opt/imboy/license.imboy
# Generated by: escript scripts/gen_license.escript <licensee> <domains> <edition> <max_users>
IMBOY_LICENSE_FILE=
