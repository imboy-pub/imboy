# IMBoy 生产部署环境变量
# 复制为 .env 并填入真实值。.env 文件切勿提交到 Git。
#
#   cp .env.example .env
#   $EDITOR .env
#
# 生成 32 字节随机密钥的命令：
#   openssl rand -hex 16
#   或：python3 -c "import secrets; print(secrets.token_hex(16))"

# ---------- 版本 ----------
# 单一版本来源：与 imboy/VERSION 保持一致
IMBOY_VERSION=1.0.0-rc.1

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 域名（必须改）----------
# 后端 API + WebSocket 域名，例如 api.example.com
API_DOMAIN=api.example.com
# 管理后台域名，例如 admin.example.com
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt 证书签发/到期通知邮箱（nginx/init-letsencrypt.sh 与 certbot 续期使用）
CERTBOT_EMAIL=ops@example.com

# ---------- 数据持久化根目录 ----------
# 建议使用独立数据盘，避免和系统盘混用
DATA_DIR=./data

# ---------- PostgreSQL ----------
POSTGRES_USER=imboy_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=imboy_pro
# 仅在需要从宿主机直连 PG 时暴露
PG_PORT=5432
# 绑定地址，默认 127.0.0.1（仅本机可达）。需要外部直连才改 0.0.0.0 —— 请先确认
# 防火墙/安全组已限制来源，PostgreSQL 直接暴露到公网是高危配置。
# PG_BIND_ADDR=0.0.0.0
PG_MEM_LIMIT=4096M
PG_IMAGE=imboy/pg18:3.6.1-2

# ---------- 后端 imboy ----------
# 镜像默认 imboy/imboy-backend:${IMBOY_VERSION}（由 compose 内插值，单一版本来源）
# 如需自定义仓库/标签，取消下行注释覆盖：
# BACKEND_IMAGE=ghcr.io/your-org/imboy-backend:1.0.0-rc.1
BACKEND_PORT=9800
# 绑定地址，默认 127.0.0.1。后端直接对外暴露等于绕过 nginx 的全部防护：
# TLS 终结、passport 登录限流(10r/m)、API 限流(60r/m)、/metrics 的 403 拦截。
# 正常部署不需要改；改之前请想清楚流量为什么不走 nginx。
# BACKEND_BIND_ADDR=0.0.0.0
BACKEND_MEM_LIMIT=8192M
# 版次：community（默认）| professional | enterprise
# professional/enterprise 功能由商业授权的闭源模块提供；社区版此处仅作启动标记
IMBOY_EDITION=community

# 销售版产品策略：严格 E2EE + 频道 + 付费内容入口
IMBOY_PRODUCT_PROFILE=community
IMBOY_E2EE_MODE=required
IMBOY_FEATURE_E2EE=true
IMBOY_FEATURE_CHANNEL=true
IMBOY_FEATURE_CHANNEL_ORDER=true
# 销售发布默认开启：要求外部支付网关=true、payment_mode=live 且至少一个商户凭据完整。
# 仅本地/社区钱包演示时才显式改为 false。
IMBOY_SALES_RELEASE=true

# ── 核心密钥（全部必须改，任意留空会导致启动 fail-fast）──────────────────────
# 生成 32 字节随机字符串：openssl rand -base64 32
JWT_KEY=CHANGE_ME_WITH_32_BYTES_SECRET__
POSTGRE_AES_KEY=CHANGE_ME_WITH_32_BYTES_SECRET__
ADM_COOKIE_SECRET=CHANGE_ME_ADM_COOKIE_SECRET____

# 客户端 init 握手加密密钥（AES-256-CBC）
# 32 字节：openssl rand -base64 32
# 16 字节 IV：openssl rand -base64 12
IMBOY_SOLIDIFIED_KEY=CHANGE_ME_32_BYTES_SOLIDIFIED_KEY_
IMBOY_SOLIDIFIED_KEY_IV=CHANGE_ME_16_BYTES_

# 密码哈希盐。生产环境（IMBOYENV != dev/local/test）为**必填**：
# imboy_app:validate_runtime_config/0 的 ensure_required_secret(password_salt)
# 在其为空时直接 erlang:error({missing_required_config, password_salt}) —— 节点起不来。
# ⚠️ 一旦有用户注册就**不可更改**，改了全部存量用户无法登录。
IMBOY_PASSWORD_SALT=CHANGE_ME_PASSWORD_SALT_32_BYTES_

# 生产环境必须开启 API 认证（设为 on，否则启动拒绝）
IMBOY_API_AUTH_SWITCH=on

# ─────────────────────────────────────────────────────────────────────
# 受信反向代理白名单 / Trusted reverse-proxy allowlist
# ─────────────────────────────────────────────────────────────────────
# 逗号分隔。只有当**直连对端**命中本名单时，后端才采信 x-forwarded-for。
# 该 IP 是登录限流(10/min)与 API 限流(60/min)两个桶的 key —— 若无条件采信
# XFF，攻击者每个请求换一个伪造 IP 即可让限流 100% 失效。
#
# 留空即用默认 127.0.0.1,::1，与本仓 nginx 的 proxy_pass http://127.0.0.1:9800
# 一致，标准单机 compose 部署无需改动。
#
# 什么时候必须配：后端前面还有云 LB / 额外一层 nginx / k8s ingress。
# 那种情况下直连对端不是 127.0.0.1，XFF 会被全部忽略，所有客户端在限流器
# 眼里变成同一个 IP、共用一个桶 —— 安全方向没问题，但正常用户会互相挤掉，
# 表现为莫名其妙的"登录过于频繁"。把各跳的出口 IP 都列进来即可。
IMBOY_TRUSTED_PROXY_IPS=

# ── RSA 登录密钥（PEM 文件路径，容器内路径）──────────────────────────────────
# 下面两个值是**容器内**路径。compose 的卷映射是
#   宿主机 ${DATA_DIR}/backend_priv  →  容器 /opt/imboy/priv_runtime
# 所以宿主机上必须写到 ${DATA_DIR}/backend_priv/keys/（不是 ./data/keys/，
# 那个目录没有被挂载进容器，写在那里后端读不到）。
#
# 正常情况下 install.sh 会自动生成，无需手工执行。手工生成方式：
#   mkdir -p ./data/backend_priv/keys
#   openssl genrsa -out ./data/backend_priv/keys/login_rsa_priv.pem 2048
#   openssl rsa -in ./data/backend_priv/keys/login_rsa_priv.pem -pubout \
#           -out ./data/backend_priv/keys/login_rsa_pub.pem
#   chmod 600 ./data/backend_priv/keys/login_rsa_priv.pem
IMBOY_LOGIN_RSA_PUB_KEY_FILE=/opt/imboy/priv_runtime/keys/login_rsa_pub.pem
IMBOY_LOGIN_RSA_PRIV_KEY_FILE=/opt/imboy/priv_runtime/keys/login_rsa_priv.pem

# ── Garage S3 附件存储（必填，否则文件上传失败）─────────────────────────────
# 本地 Garage：http://127.0.0.1:3900
# Cloudflare R2：https://<ACCOUNT_ID>.r2.cloudflarestorage.com
IMBOY_GARAGE_ENDPOINT=http://garage:3900
IMBOY_GARAGE_BUCKET=imboy
IMBOY_GARAGE_ACCESS_KEY=CHANGE_ME_GARAGE_ACCESS_KEY
IMBOY_GARAGE_SECRET_KEY=CHANGE_ME_GARAGE_SECRET_KEY

# ── LiveKit RTC（群通话/屏幕共享/录制）───────────────────────────────────────
# API key/secret 自定义生成即可（secret ≥ 32 字符），后端签 token 与 SFU 校验共用
# 生成示例：LIVEKIT_API_SECRET=$(openssl rand -hex 24)
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET_AT_LEAST_32_CHARS
# 录制输出桶（Garage，需预先创建并授权同一组 Garage key）
# LIVEKIT_RECORDING_BUCKET=imboy-recordings
# 客户端信令地址，默认 wss://${API_DOMAIN}/livekit（经 nginx 反代），一般无需改
# IMBOY_LIVEKIT_WS_URL=
# ⚠️ 防火墙/云安全组必须放行：UDP 50000-50200（媒体）+ TCP 7881（ICE/TCP 兜底）


# ── 短信验证码（可选；sms.switch=on 时必填）──────────────────────────────────
# 平台：yjsms | aliyun
# IMBOY_SMS_PLATFORM=yjsms
# IMBOY_YJSMS_ACCOUNT=
# IMBOY_YJSMS_SECRET=

# 可选：Sentry 监控
SENTRY_DSN=

# ---------- 管理后台 ----------
# 镜像默认 imboy/imboy-admin:${IMBOY_VERSION}（由 compose 内插值）
# 如需自定义仓库/标签，取消下行注释覆盖：
# ADMIN_IMAGE=ghcr.io/your-org/imboy-admin:1.0.0-rc.1

# ---------- Grafana 可观测性仪表盘 ----------
# 登录地址：http://<server-ip>:3000  用户名 admin
# Dashboard URL: http://<server-ip>:3000  username: admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3000
# 绑定地址，默认 127.0.0.1。Grafana 无 TLS，公网暴露 = 明文传管理口令。
# 远程访问请走 nginx 反代或 SSH 隧道，而不是改这一项。
# GRAFANA_BIND_ADDR=0.0.0.0

# ─────────────────────────────────────────────────────────────────────
# 支付配置 / Payment Configuration
#
# 外部支付网关总开关（销售版模板为 true；社区/演示部署可改为 false）
#
# false：充值下单/支付/查单、网关回调、提现端点一律返回「功能未启用」；
#        后端跳过网关凭据的启动校验。**站内钱包账务（余额、流水、红包、
#        转账）不受影响，照常可用。** 没有支付商户号也能正常部署。
# true ：启用对外收款，此时下面整段凭据配置才生效。
#
# 只有精确的 true / 1（忽略大小写与首尾空白）才算开启，其余一律关闭。
IMBOY_PAYMENT_GATEWAY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────
# 动态插件生命周期写操作总开关（默认 false = 不启用，A-28）
#
# false：/api/adm/plugin/* 的 7 个写端点（install/enable/disable/upgrade/
#        uninstall/reset/force_uninstall）返回「功能未启用」。该子系统冻结
#        （@status FROZEN）：install 的 Path 无白名单（审计 #43）、签名 100%
#        放行（#44），admin 可达即代码加载面。**内置功能开关（channel/moment/
#        location/group_collab）是纯 manifest、只读可见，不受此开关影响。**
# true ：放行写端点（需自行承担动态加载的安全风险）。
#
# 只有精确的 true / 1（忽略大小写与首尾空白）才算开启，其余一律关闭。
IMBOY_PLUGIN_LIFECYCLE_ENABLED=false
# ─────────────────────────────────────────────────────────────────────

# 销售版上线前检查清单（IMBOY_SALES_RELEASE=true 时强制执行）:
#   1. 确认 IMBOY_PAYMENT_MODE=live（默认即 live；生产用 sandbox 会启动失败）
#   2. 填入至少一个网关的完整凭据
#   3. 在支付平台后台配置回调 URL（必须 HTTPS）
# ─────────────────────────────────────────────────────────────────────

# 支付模式：live（默认，真实验签）| sandbox（回调直通不验签，仅供本地联调）
# Payment mode: live (default, real verification) | sandbox (pass-through, LOCAL ONLY)
#
# ⚠️ sandbox 会**完全跳过回调验签**，而回调端点是免 JWT 的第三方入口 ——
#    生产上一旦是 sandbox，任何人 POST 一条自造回调即可凭空充值。
#    因此 IMBOYENV=pro/prod/production 时 sandbox 会导致节点**启动失败**
#    （imboy_app:ensure_payment_mode_safe/0），这是刻意的：宁可起不来，
#    也不要带着零验签对外服务。
#    另注：任何无法识别的值（如 production、Live 带尾空格）都会落到 live，
#    只有精确的 "sandbox" 才进 sandbox。
#
# ⚠️ 本项仅在 IMBOY_PAYMENT_GATEWAY_ENABLED=true 时生效。总开关关闭时
#    网关端点直接拒绝，不存在验签与否的问题。
IMBOY_PAYMENT_MODE=live

# ─── 微信支付 APIv3 / WeChat Pay APIv3 ───
# 启用微信支付时必填；live 模式缺任意一项，则微信回调一律返回 {error, no_credential}
# Required when using WeChat Pay; missing any field in live mode rejects all WeChat callbacks
IMBOY_WECHAT_MCH_ID=
IMBOY_WECHAT_APP_ID=
IMBOY_WECHAT_API_V3_KEY=
IMBOY_WECHAT_CERT_SERIAL=
# PEM 格式私钥，多行请用引号包裹：IMBOY_WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
IMBOY_WECHAT_PRIVATE_KEY=
IMBOY_WECHAT_PLATFORM_PUBLIC_KEY=
# 微信回调地址（必须 HTTPS），例：https://api.example.com/v1/payment/callback/wechat
IMBOY_WECHAT_NOTIFY_URL=

# ─── 支付宝 / Alipay ───
IMBOY_ALIPAY_APP_ID=
# RSA2 应用私钥（PKCS#8 格式）
IMBOY_ALIPAY_PRIVATE_KEY=
# 支付宝公钥（用于验签）
IMBOY_ALIPAY_PUBLIC_KEY=
# 例：https://api.example.com/v1/payment/callback/alipay
IMBOY_ALIPAY_NOTIFY_URL=

# ─── Stripe ───
# sk_live_... 格式（沙箱用 sk_test_...，但同时需要 IMBOY_PAYMENT_MODE=sandbox）
IMBOY_STRIPE_SECRET_KEY=
# 在 Stripe Dashboard → Webhooks → 签名密钥（whsec_...）
IMBOY_STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# License 授权 / License Authorization
#
# 社区版（community）无需 License 文件。
# professional / enterprise 版必须配置，否则回退社区版配额限制。
# Community edition does not need a license file.
# Professional/Enterprise edition requires this; missing = community limits apply.
# ─────────────────────────────────────────────────────────────────────

# License 文件绝对路径，例：/opt/imboy/license.imboy
# Generated by: escript scripts/gen_license.escript <licensee> <domains> <edition> <max_users>
IMBOY_LICENSE_FILE=

# ---------- 可观测性 overlay（docker-compose.observability.yml，B-24）----------
# postgres_exporter 连接账号。留空则回落到 POSTGRES_USER/POSTGRES_PASSWORD。
# 建议单建只读账号（pg_monitor 角色）而非复用超级用户 —— exporter 只需读统计视图：
#   CREATE USER imboy_exporter PASSWORD '...'; GRANT pg_monitor TO imboy_exporter;
# PG_EXPORTER_USER=imboy_exporter
# PG_EXPORTER_PASSWORD=CHANGE_ME
