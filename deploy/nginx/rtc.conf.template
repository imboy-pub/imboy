# 社区版独立 RTC 信令域 / Dedicated community LiveKit signaling origin.
# Only RTC_DOMAIN is substituted; Nginx variables are preserved by the filter.
# $connection_upgrade is defined in imboy.conf.template.
server {
    listen 80;
    server_name ${RTC_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${RTC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${RTC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RTC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /metrics { return 403; }
    location / {
        proxy_pass http://imboy_livekit:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
