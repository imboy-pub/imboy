# ============================================================
# Alertmanager 通知渠道取值 / Alertmanager notification settings
# ------------------------------------------------------------
# 复制后填写，**不要提交填好的那份**：
#   cp deploy/alertmanager/alertmanager.env.example deploy/alertmanager/alertmanager.env
#   chmod 600 deploy/alertmanager/alertmanager.env
#   $EDITOR deploy/alertmanager/alertmanager.env
#   bash deploy/alertmanager/render.sh
#
# ⚠️ 这里的值**全部留空是有意的**：收件邮箱与 webhook 是每个部署自己的联系方式，
#   仓库里不该有任何一个真实地址。留空时渲染出的配置 receiver='null'，
#   即"告警只进 UI，没有任何人会被通知到" —— 那不是可接受的生产状态，
#   render.sh 与 preflight 都会大声提醒。
#
# ⚠️ webhook URL 本身就是凭据：谁拿到谁就能往你的群里发消息。按密钥对待。
# ============================================================

# ---------- 选择渠道 ----------
# 可选值：null（只进 UI）| email | webhook
# 生产上 critical 至少要有一个真实渠道，否则 Sellable 判据第 6 条
# "故障有人被通知到（不是只进 UI）"为假。
ALERT_RECEIVER_CRITICAL=null
# 非 critical 的去向。噪声较多，很多团队保持 null 只看 UI，是合理选择。
ALERT_RECEIVER_DEFAULT=null

# ---------- 邮件（ALERT_RECEIVER_* 选了 email 才需要）----------
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
# 自建/内网 SMTP 常见无 TLS；对外 SMTP 一律保持 true
ALERT_SMTP_REQUIRE_TLS=true
# 收件人。多个用逗号分隔。
ALERT_EMAIL_TO=

# ---------- IM 群机器人（选了 webhook 才需要）----------
# 钉钉/飞书的原生格式与 Alertmanager 不同，中间**必须**有个转换器。
# 本仓提供钉钉转换器：deploy/docker-compose.alert-dingtalk.yml（opt-in overlay）。
#
# 用该 overlay 时 ALERT_WEBHOOK_URL 就填下面这个固定值 —— 它由
# overlay 里的 container_name(dingtalk-webhook) + 端口(8060) + profile 名(ops) 决定，
# 三者任一改动这里必须同步改。⚠️ 对不上不会报错，告警只是**静默发不出去**。
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=http://dingtalk-webhook:8060/dingtalk/ops/send

# 钉钉群机器人的 Webhook 地址（含 access_token），仅
# docker-compose.alert-dingtalk.yml 使用。⚠️ 这是凭据，按密钥对待。
# ⚠️ 机器人安全设置若选了「加签」，还需要 secret，CLI 表达不了，
#    得改配置文件形式 —— 用加签就先说，别直接填这里。
DINGTALK_ROBOT_URL=
