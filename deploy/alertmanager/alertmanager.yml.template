# ============================================================
# Alertmanager 配置模板 / Alertmanager config template
# ------------------------------------------------------------
# ⚠️ 不要直接改 alertmanager.yml —— 它由本模板渲染产出，手改会被下次渲染覆盖。
#   渲染：bash deploy/alertmanager/render.sh
#   取值：deploy/alertmanager/alertmanager.env（从 alertmanager.env.example 复制后填写）
#
# 为什么用模板 + envsubst 而不是直接把值写进 yml：
#   收件邮箱 / webhook 是**每个部署各不相同的联系方式**，写进仓库既不对也危险
#   （webhook URL 本身就是凭据，谁拿到谁就能往群里发消息）。
#   本仓 nginx 已经是这个范式（deploy/nginx/templates/*.template），这里照搬。
#
# B-25 修的是什么：此前所有 receiver 都是 'null'，且 email/dingtalk 段整段被注释。
#   后果不是"少了个通知渠道"——是**所有告警都只进 Alertmanager 的 UI，没有任何人
#   会被通知到**。Sellable 判据第 6 条"故障有人被通知到（不是只进 UI）"直接为假。
#   本模板把两个 receiver 结构写成**可用状态**，只留值待填。
# ============================================================

global:
  resolve_timeout: 5m
  smtp_smarthost: '${ALERT_SMTP_SMARTHOST}'
  smtp_from: '${ALERT_SMTP_FROM}'
  smtp_auth_username: '${ALERT_SMTP_USERNAME}'
  smtp_auth_password: '${ALERT_SMTP_PASSWORD}'
  # 自建/内网 SMTP 常见无 TLS；有 TLS 就设 true（默认 true 更安全，按需在 env 覆盖）
  smtp_require_tls: ${ALERT_SMTP_REQUIRE_TLS}

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  # 非 critical 的默认去向。未配置时为 'null'（只进 UI）。
  receiver: '${ALERT_RECEIVER_DEFAULT}'

  routes:
    # critical 走独立分支：更短的聚合等待 + 更频繁的重复提醒。
    # 判据「停 PG，5 分钟内收到通知」靠的就是这里的 group_wait=10s。
    - match:
        severity: critical
      group_wait: 10s
      repeat_interval: 1h
      receiver: '${ALERT_RECEIVER_CRITICAL}'

receivers:
  # 只进 UI，不通知任何人。**这是未配置时的兜底，不是可接受的生产状态。**
  - name: 'null'

# ⚠️ 下面两段由 render.sh 按是否真的被使用来**保留或整段删除**。
#   原因：receiver 里留空的 url/to 字段会让 Alertmanager 拒绝加载**整份**配置，
#   于是「没填渠道」会从「只进 UI」恶化成「整个 Alertmanager 起不来」——
#   比修之前更糟。没配就不输出，未配置态的产物形状与原文件一致（只有 null）。
#   标记行本身也会被 render.sh 去掉，不会出现在产物里。

#>>>RECEIVER:email
  - name: 'email'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true
        headers:
          Subject: '[IMBoy][{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
#<<<RECEIVER:email

  # 钉钉/飞书等 IM 群机器人。webhook_configs 是通用的：
  # 钉钉需经 prometheus-webhook-dingtalk 之类的转换器，飞书同理。
#>>>RECEIVER:webhook
  - name: 'webhook'
    webhook_configs:
      - url: '${ALERT_WEBHOOK_URL}'
        send_resolved: true
#<<<RECEIVER:webhook

inhibit_rules:
  # 节点整体挂掉时，抑制它派生出的其它告警，避免一次故障刷屏几十条
  - source_match:
      alertname: IMBoyNodeDown
    target_match_re:
      alertname: '.+'
    equal: ['instance']
