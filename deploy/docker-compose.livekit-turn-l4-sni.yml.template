# Generated by install-livekit-l4-sni.sh. Do not put secrets in this file.
services:
  __LIVEKIT_SERVICE__:
    environment:
      TZ: ${TZ:-Asia/Shanghai}
      LIVEKIT_CONFIG: |
        port: 7880
        rtc:
          tcp_port: 7881
          port_range_start: 50000
          port_range_end: 50200
          use_external_ip: true
        turn:
          enabled: true
          domain: __TURN_DOMAIN__
          cert_file: /etc/livekit/certs/fullchain.pem
          key_file: /etc/livekit/certs/privkey.pem
          tls_port: 443
          udp_port: 3478
          relay_range_start: 50201
          relay_range_end: 50500
          proxy_protocol: true
          proxy_protocol_trusted_cidrs:
            - __DOCKER_GATEWAY_CIDR__
        keys:
          ${LIVEKIT_API_KEY:?LIVEKIT_API_KEY is required}: ${LIVEKIT_API_SECRET:?LIVEKIT_API_SECRET is required}
        logging:
          level: info
    volumes:
      - __LIVEKIT_TURN_CERT_DIR__:/etc/livekit/certs:ro
    ports:
      - "127.0.0.1:15443:443"
      - "3478:3478/udp"
      - "50201-50500:50201-50500/udp"
