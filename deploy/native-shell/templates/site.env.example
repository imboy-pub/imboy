# Copy to site.env. KEY=value only, without quotes/export/shell expressions.
# Non-secret site data. The installer generates all internal secrets on the host.
SITE_NAME=imboy-site
API_DOMAIN=api.example.com
S3_DOMAIN=s3.example.com
FILES_DOMAIN=files.example.com
TLS_DIR=/root/imboy-tls
# Single-node advertised storage; must fit within real available storage.
GARAGE_CAPACITY=10G
# Browser origins, separated by commas; empty disables cross-origin browser access.
# Native Flutter clients do not require CORS. Fill actual web/admin origins if used.
CORS_ORIGINS=
