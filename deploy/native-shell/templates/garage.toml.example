# Reference only. The installer generates secrets on the target.
# GENERATED_ON_TARGET is not a valid production secret.
metadata_dir = "/var/lib/imboy/garage/meta"
data_dir = "/var/lib/imboy/garage/data"
db_engine = "lmdb"
replication_factor = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "GENERATED_ON_TARGET"

[s3_api]
s3_region = "garage"
api_bind_addr = "127.0.0.1:3900"

[s3_web]
bind_addr = "127.0.0.1:3902"
root_domain = ".garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token = "GENERATED_ON_TARGET"
