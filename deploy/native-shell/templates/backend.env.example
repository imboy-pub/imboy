# IMBoy native backend environment reference — no real credentials.
# This file documents /etc/imboy/backend.env generated by install.sh.
# Do not source this file. Do not copy it over an initialized deployment.
# Site choices belong in site.env; secrets are generated once and retained.
# Runtime source: cb95fa72f9bc617d0f30ddd6b98da51f39cfd2af (alpha.83).

IMBOYENV=pro
IMBOY_EDITION=community
IMBOY_PRODUCT_PROFILE=phase1_delivery

# The actual listener override in imboy_app is HTTP_PORT.
# IMBOY_HTTP_PORT is not consumed at this source baseline.
HTTP_PORT=9800
TZ=Asia/Shanghai
ERL_EPMD_ADDRESS=127.0.0.1
ERL_CRASH_DUMP=/var/lib/imboy/backend/erl_crash.dump

# Native single-host database. Both pg_conf and super_account are overridden.
IMBOY_PG_HOST=127.0.0.1
IMBOY_PG_PORT=5432
IMBOY_PG_USER=imboy
IMBOY_PG_DB=imboy
IMBOY_PG_PASSWORD=GENERATED_ON_TARGET

# Exact routes verified against src/imboy_router.erl.
IMBOY_BASE_URL=https://api.example.com
IMBOY_WS_URL=wss://api.example.com/api/v1/ws

# The three core values must each be at least 32 ASCII bytes and be distinct.
IMBOY_JWT_KEY=GENERATED_ON_TARGET
IMBOY_POSTGRE_AES_KEY=GENERATED_ON_TARGET_32_ASCII_BYTES
IMBOY_ADM_COOKIE_SECRET=GENERATED_ON_TARGET

# Fixed-length input: solidified key=32 bytes; IV=16 bytes.
# The paired Flutter/admin client must use the same agreed initial-config
# encryption/signature contract. Do not send these values in a support report.
IMBOY_SOLIDIFIED_KEY=GENERATED_ON_TARGET_32_ASCII_BYTES
IMBOY_SOLIDIFIED_KEY_IV=GENERATED_ON_TARGET_16_ASCII_BYTES
IMBOY_PASSWORD_SALT=GENERATED_ON_TARGET

# RSA is generated on the target and kept outside all versioned releases.
IMBOY_LOGIN_RSA_PUB_KEY_FILE=/etc/imboy/keys/login_rsa_pub.pem
IMBOY_LOGIN_RSA_PRIV_KEY_FILE=/etc/imboy/keys/login_rsa_priv.pem
IMBOY_JVERIFICATION_RSA_PRIV_KEY_FILE=/etc/imboy/keys/login_rsa_priv.pem

IMBOY_API_AUTH_SWITCH=on
IMBOY_AUTO_MIGRATE=true

# Internal S3 API / external signed S3 API are different addresses.
# The public endpoint has its own hostname and no /s3 prefix.
IMBOY_GARAGE_ENDPOINT=http://127.0.0.1:3900
IMBOY_GARAGE_PUBLIC_ENDPOINT=https://s3.example.com
IMBOY_GARAGE_BUCKET=imboy
IMBOY_GARAGE_PUBLIC_BUCKET=imboy-public
IMBOY_GARAGE_ACCESS_KEY=GENERATED_BY_GARAGE
IMBOY_GARAGE_SECRET_KEY=GENERATED_BY_GARAGE

# Generates immutable private/public registry roots from the active Garage
# configuration. Do not change bucket names or the storage endpoint in place
# after accepting the first uploaded object.
IMBOY_ATTACHMENT_REGISTRY_FROM_GARAGE=true

# public_base_url=https://files.example.com and region=garage are written into
# sys.config's garage map. There is no IMBOY_GARAGE_PUBLIC_BASE_URL override.
# files.example.com maps to Garage Website 3902 with Host:
# imboy-public.garage.localhost. Private bucket Website access stays disabled.

IMBOY_TRUSTED_PROXY_IPS=127.0.0.1,::1
IMBOY_FEATURE_E2EE=false
IMBOY_E2EE_MODE=disabled
IMBOY_FEATURE_CHANNEL=true
IMBOY_FEATURE_CHANNEL_ORDER=false
IMBOY_PAYMENT_GATEWAY_ENABLED=false
IMBOY_PAYMENT_MODE=live
IMBOY_PLUGIN_LIFECYCLE_ENABLED=false
IMBOY_SMS_SWITCH=off

# Unique per concurrently active deployment. This package owns one node only.
# Do not clone a running instance with the same data-center/node pair.
IMBOY_TSID_DC_ID=1
IMBOY_TSID_NODE_ID=1
IMBOY_TSID_DC_BITS=3

# Optional runtime subject-HMAC material for the customer-service feature.
# Its presence does not provision an organization, workspace or seat.
IMBOY_CS_WIDGET_SUBJECT_KEY=GENERATED_ON_TARGET

# Extra service configuration is conditional and not enabled by this package.
# SMTP: IMBOY_SMTP_RELAY / PORT / SSL / USERNAME / PASSWORD / FROM.
# Admin/widget CORS: IMBOY_CORS_ADMIN_ORIGINS / IMBOY_CORS_WIDGET_ORIGINS.
# Push, SMS, external payment, OIDC/OA, enterprise keyring and customer-service
# onboarding need a separately completed contract and UAT. Never infer those
# integrations are ready because /readyz returned 200.
# The root runtime sys.config preserves upstream throttle and ecron definitions;
# it binds HTTP only to 127.0.0.1, has no cluster peers, disables dev localhost
# CORS, uses persistent log/Mnesia paths, and contains no LLM provider endpoint.
