# LiveKit TURN/TLS :443 L4 SNI switch settings.
# This file contains no secret. Copy it to /etc/imboy/livekit-l4-sni.env and
# adjust paths/domains before running install-livekit-l4-sni.sh.

TURN_DOMAIN=turn.imboy.pub

# Nginx binary of the instance that actually serves :443.
# Leave empty to auto-detect: common BT panel paths (/www/server/nginx/sbin/nginx,
# /www/server/openresty/nginx/sbin/nginx, /usr/local/nginx/sbin/nginx,
# /usr/local/openresty/nginx/sbin/nginx) then PATH "nginx"; the pick must match
# the running "nginx: master process" or the installer aborts (BLOCKED_ENV).
# When set explicitly it must be executable -- no silent fallback, ever.
# NGINX_BIN=/www/server/nginx/sbin/nginx
NGINX_BIN=

# Existing host Nginx/OpenResty layout (BT panel defaults shown here).
NGINX_VHOST_DIR=/www/server/panel/vhost/nginx
NGINX_STREAM_CONF=/www/server/panel/vhost/nginx/tcp/livekit-turn-l4-sni.conf
NGINX_REALIP_CONF=/www/server/panel/vhost/nginx/0.livekit-l4-sni-realip.conf
HTTPS_VHOST_FILES="cs.imboy.pub.conf dev.imboy.pub.conf pro.imboy.pub.conf prodadm.imboy.pub.conf rtc.imboy.pub.conf s3.imboy.pub.conf trace.imboy.pub.conf www.imboy.pub.conf"

# Expected status codes are checked locally through the new :443 SNI entry.
# Keep an existing non-200 baseline (for example 404/502) as-is.
HTTPS_HEALTH_CONTRACTS="cs.imboy.pub:404 dev.imboy.pub:200 pro.imboy.pub:200 prodadm.imboy.pub:200 rtc.imboy.pub:200 s3.imboy.pub:404 trace.imboy.pub:502 www.imboy.pub:200 imboy.pub:200"

# Existing LiveKit Compose deployment and secret-bearing env file.
COMPOSE_DIR=/etc/imboy
COMPOSE_FILE=/etc/imboy/livekit-compose.yml
# Operator overlays that the RUNNING stack was started with (space separated,
# absolute or relative to COMPOSE_DIR). They are validated and applied together
# with the generated L4 SNI overlay, snapshotted in the backup, and re-used by
# --rollback so the stack is never rebuilt from a base-only Compose combination.
# Leave empty when the stack runs on the single base file.
COMPOSE_OVERLAY_FILES=
COMPOSE_ENV_FILE=/etc/imboy/livekit.env
LIVEKIT_SERVICE=imboy_livekit
LIVEKIT_CONTAINER=imboy_livekit
LIVEKIT_HEALTH_URL=http://127.0.0.1:7880/
BACKEND_HEALTH_URL=http://127.0.0.1:9800/healthz
# Normally auto-detected. Set only when the container has multiple Docker
# networks; use the one exact gateway IP seen by published-port connections.
# LIVEKIT_PROXY_TRUSTED_IP=172.29.0.1

# HAProxy config path (package default shown; override for non-Debian layouts).
HAPROXY_CONF=/etc/haproxy/haproxy.cfg

# Task-1 listen-drift checker invoked before/after every nginx reload
# (--pre-switch on current config, --strict on candidate/installed config).
# Default: scripts/check_l4_sni_listen.sh shipped next to deploy/. Override only
# for tests; a missing or non-executable checker blocks the switch (fail-closed).
# L4_SNI_CHECK_SCRIPT=/opt/imboy/check_l4_sni_listen.sh

# Existing Let's Encrypt lineage. The private key is never copied to the repo.
LIVEKIT_TURN_CERT_DIR=/etc/letsencrypt/live/turn.imboy.pub
CERTBOT_HOOK=/etc/letsencrypt/renewal-hooks/deploy/livekit-turn-cert.sh

# Old TURN is stopped and disabled during apply, but never uninstalled.
ETURNAL_SERVICE=eturnal

# Generated state and backups. Do not delete while this switch is active.
L4_STATE_DIR=/var/lib/imboy-livekit-l4-sni
L4_BACKUP_ROOT=/root/imboy-livekit-l4-sni-backups
