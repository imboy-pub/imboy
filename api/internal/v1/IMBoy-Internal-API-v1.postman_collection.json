            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "分页查询本组织已映射用户（只回元数据）。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page_size\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
