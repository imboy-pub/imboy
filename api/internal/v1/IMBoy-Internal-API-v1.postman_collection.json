    },
    {
      "name": "企业文件（两段式直传）",
      "description": "presign 拿预签名 URL → 对象存储直传 → confirm 确认入库。",
      "item": [
        {
          "name": "INT-07 直传预签名",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/presign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "presign"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "第一段：请求对象存储预签名。请求体字段（对象键/大小/类型等）在对接启动时由平台方提供字段说明；本示例暂不预填。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"notice.pdf\",\n  \"mime_type\": \"application/pdf\",\n  \"size_bytes\": 20480\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-08 确认入库",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "confirm"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "第二段：直传完成后确认入库，取得可引用的文件标识。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object_key\": \"ent/9100000000000000001/9100000000000000003/2026/09/notice.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-22 文件治理动作",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/governance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "governance"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "文件生命周期/元数据治理动作。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"op\": \"set_retention\",\n  \"object_key\": \"ent/9100000000000000001/9100000000000000003/2026/09/notice.pdf\",\n  \"retention_days\": 30,\n  \"reason\": \"OA 审计留存\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "消息（sender_mode 语义见 README §6）",
      "description": "应用身份直发 / 代人类发送；单聊与群聊；固定非端到端加密。",
      "item": [
        {
          "name": "INT-09 单聊发送",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/messages/direct",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "messages",
                "direct"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "sender_mode=application：以应用身份发；sender_mode=human：代人类发（追加 principal_user_id，消耗 messages:send_as_human）。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_mode\": \"application\",\n  \"recipient_user_id\": \"oa-1002\",\n  \"msg_type\": \"text\",\n  \"content\": \"您好，来自 OA 的通知\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-10 群聊发送",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/groups/{{group_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "groups",
                ":group_id}",
                "messages"
              ],
              "variable": [
                {
                  "key": "group_id",
                  "value": "{{group_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "向企业群发送托管消息。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_mode\": \"application\",\n  \"msg_type\": \"text\",\n  \"content\": \"项目群通知\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
