                "internal",
                "v1",
                "channels"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              }
            ],
            "description": "分页查看工作区企业频道（scope=workspace AND status=1，W 必填）。无请求体。"
          }
        },
        {
          "name": "INT-31 频道详情",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/channels/{{channel_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "channels",
                ":channel_id}"
              ],
              "variable": [
                {
                  "key": "channel_id",
                  "value": "{{channel_id}}"
                }
              ]
