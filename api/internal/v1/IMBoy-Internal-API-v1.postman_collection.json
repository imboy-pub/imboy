    {
      "name": "Webhook（出站回调）",
      "description": "登记回调地址、查询投递、重放失败投递。签名头 x-imboy-delivery/event/timestamp/signature。",
      "item": [
        {
          "name": "INT-12 登记/更新 Webhook",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "webhook"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "设置你方回调 URL 与关注的事件。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_url\": \"https://oa.example.com/imboy/callback\",\n  \"name\": \"OA 回调\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-23 查询投递列表",
          "request": {
            "method": "GET",
