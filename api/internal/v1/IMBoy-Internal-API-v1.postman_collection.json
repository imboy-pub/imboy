    {
      "name": "企业文件（两段式直传）",
      "description": "presign 拿预签名 URL → 对象存储直传 → confirm 确认入库。",
      "item": [
        {
          "name": "INT-07 直传预签名",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/presign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "presign"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "第一段：请求对象存储预签名。请求体字段（对象键/大小/类型等）在对接启动时由平台方提供字段说明；本示例暂不预填。"
          }
        },
        {
          "name": "INT-08 确认入库",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "confirm"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "第二段：直传完成后确认入库，取得可引用的文件标识。"
          }
        },
        {
          "name": "INT-22 文件治理动作",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/files/governance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "files",
                "governance"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "文件生命周期/元数据治理动作。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": 9100000000000000400\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "消息（sender_mode 语义见 README §6）",
      "description": "应用身份直发 / 代人类发送；单聊与群聊；固定非端到端加密。",
      "item": [
        {
          "name": "INT-09 单聊发送",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/messages/direct",
