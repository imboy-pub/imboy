    {
      "name": "Webhook（出站回调）",
      "description": "登记回调地址、查询投递、重放失败投递。签名头 x-imboy-delivery/event/timestamp/signature。",
      "item": [
        {
          "name": "INT-12 登记/更新 Webhook",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "webhook"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "设置你方回调 URL 与关注的事件。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://oa.example.com/imboy/callback\",\n  \"events\": [\n    \"message.enterprise.accepted\",\n    \"message.enterprise.failed\",\n    \"file.confirmed\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-23 查询投递列表（cursor 分页）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/webhook/deliveries",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "webhook",
                "deliveries"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true,
                  "description": "可选：按投递状态过滤（pending/retry/success/dead；参与游标绑定——换 status 的旧游标 400）"
                },
                {
                  "key": "page_size",
                  "value": "20",
                  "description": "页大小，1..50（缺省 20）；越界/非整数一律 400 invalid_request（拒绝，不静默截断）"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true,
                  "description": "上一页返回的 next_cursor（首页缺省）。CURSOR-V2 签名游标：base64url(canonical_json).base64url(HMAC-SHA256)，24h 有效；篡改/垃圾串/跨页族/换过滤/过期一律 400 invalid_request"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              }
            ],
            "description": "投递元数据 cursor 分页（CP-CON-02 切 CURSOR-V2 keyset，DEC-INT23-COMPAT；响应 {items, page_size, has_more, next_cursor, summary}，排序 created_at DESC, delivery_id DESC）。无请求体。\n注意：旧 offset 参数 page/size 任一出现即 400 cursor_required_v1（versioned 迁移错误）——不存在「带着 page 用游标」的过渡形态。"
          }
        },
        {
          "name": "INT-13 重放投递",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/webhook/deliveries/{{delivery_id}}/replay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "webhook",
                "deliveries",
                ":delivery_id}",
                "replay"
              ],
              "variable": [
                {
                  "key": "delivery_id",
                  "value": "{{delivery_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "对失败投递按 delivery_id 重放。"
          }
        },
        {
          "name": "INT-32 测试投递（合成 webhook.ping）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "demo-idem-32",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/internal/v1/webhook/test-delivery",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "webhook",
                "test-delivery"
              ]
            },
            "description": "向当前配置的回调端点投递合成 webhook.ping 事件验证连通性；需先 INT-12 配置。返回 delivery_id 可用于 INT-23 查询 / INT-13 重放。"
          }
        }
      ]
    },
    {
      "name": "OA SSO（一次性 code 交换）",
