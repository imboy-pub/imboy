{
  "info": {
    "name": "IMBoy Internal API v1",
    "_postman_id": "74b0c0be-ae23-5011-b04e-a7776770f4bd",
    "description": "IMBoy 企业内部集成 API（/api/internal/v1）。\n\n本集合收录冻结路由表中已实现、可调用的 31 个端点（V2.1 起含 Workspace / 企业群 / 企业项目 / 企业频道的 8 个只读端点 INT-24..31）；客服坐席与各资源 P1 写操作等待补合同见 endpoints.md 的企业数据 CRUD 覆盖审计，未实现路径不会作为假请求加入本集合。\n\n使用前设置两个变量：\n  1. base_url —— 由平台部署方提供；\n  2. credential —— 平台管理员在治理台签发的集成凭证（Bearer ib_int_<id>.<secret>），secret 明文仅在签发时可见一次。\n\n配套文档：README.md（概念）、endpoints.md（端点参考与覆盖审计）、CHANGELOG.md（版本）。\n所有示例值均为合成数据，不含真实凭据。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:9800",
      "description": "由平台部署方提供（示例为本地联调值）"
    },
    {
      "key": "credential",
      "value": "ib_int_9100000000000000003.SYNTHETIC-NOT-A-REAL-SECRET",
      "description": "集成凭证；此处为合成占位，请替换为治理台签发的真实凭证"
    },
    {
      "key": "idempotency_key",
      "value": "{{$guid}}",
      "description": "写动作幂等键；同一业务操作请复用同一 key"
    },
    {
      "key": "group_id",
      "value": "9100000000000000100",
      "description": "示例群组 ID（合成）"
    },
    {
      "key": "delivery_id",
      "value": "9100000000000000200",
      "description": "示例投递 ID（合成）"
    },
    {
      "key": "workspace_id",
      "value": "1",
      "description": "示例 Workspace ID（须为本应用 Grant 覆盖的工作区）"
    },
    {
      "key": "project_id",
      "value": "9100000000000000600",
      "description": "示例企业项目 ID（合成）"
    },
    {
      "key": "channel_id",
      "value": "9100000000000000700",
      "description": "示例企业频道 ID（合成）"
    }
  ],
  "item": [
    {
      "name": "应用与凭证",
      "description": "读取本应用自身（健康检查与联调首选）。",
      "item": [
        {
          "name": "INT-01 读取应用信息",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/application",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "application"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              }
            ],
            "description": "返回本应用名称、组织、授予的 scope、状态。无请求体。"
          }
        }
      ]
    },
    {
      "name": "外部身份映射",
      "description": "OA 用户标识 ↔ 平台用户 的绑定 / 解析 / 解绑 / 目录。",
      "item": [
        {
          "name": "INT-02 绑定身份",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/identity-mappings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "identity-mappings"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "把 OA 侧用户标识绑定到平台用户。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_user_id\": \"oa-1001\",\n  \"user_id\": 9100000000000000300,\n  \"workspace_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-03 解析身份",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/identity-mappings/resolve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "identity-mappings",
                "resolve"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "OA 标识 → 平台用户。未映射返回 identity_not_mapped(422)。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_user_id\": \"oa-1001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-15 解绑身份",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/identity-mappings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "identity-mappings"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "description": "解绑后该用户对你的消息/群操作立即不可达。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_user_id\": \"oa-1001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "INT-16 已映射目录",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/internal/v1/identity-mappings/directory",
