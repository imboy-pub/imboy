# IMBoy 交互开发镜像 / Interactive development image
# 挂载当前源码到 /workspace/imboy；镜像不克隆或切换任何远端分支。
# Mount the current checkout; do not clone or switch a remote source tree.
FROM erlang:29.1.3@sha256:a78e8a76fcd0618410c9b7590616c386d404278aa61d50b255f463912f2b80a5

ENV IMBOYENV=local

# 保留原生编译工具和头文件，便于挂载源码后构建依赖/NIF。
# Keep native build tools and headers for dependencies and NIF development.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      autoconf build-essential ca-certificates curl git vim \
      libncurses-dev libssl-dev unixodbc-dev libsctp-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root by default; match the host IDs when compiling a bind-mounted checkout.
# macOS 常用 GID 20 在 Debian 中可能已存在，因此复用已有数字组。
ARG DEV_UID=10001
ARG DEV_GID=10001
RUN set -eu; \
    test "$DEV_UID" -gt 0; \
    test "$DEV_GID" -gt 0; \
    if ! getent group "$DEV_GID" >/dev/null; then groupadd --gid "$DEV_GID" imboy; fi; \
    useradd --uid "$DEV_UID" --gid "$DEV_GID" --create-home --home-dir /home/imboy \
      --shell /bin/bash imboy; \
    install -d -o imboy -g "$DEV_GID" /workspace/imboy

ENV HOME=/home/imboy
WORKDIR /workspace/imboy
USER imboy
EXPOSE 9800 9806
CMD ["bash"]
