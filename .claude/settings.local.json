{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(IMBOYENV=local make run)",
      "Bash(./bin/imboy ping:*)",
      "Bash(curl:*)",
      "Bash(psql:*)",
      "Bash(find:*)",
      "Bash(make:*)",
      "Bash(lsof:*)",
      "Bash(npm run dev:*)",
      "Bash(node:*)",
      "Bash(NODE_OPTIONS=\"--no-warnings\" VITE_SKIP_OPTIMIZE_DEPS=true npm run dev)",
      "Bash(pkill:*)",
      "WebSearch",
      "Bash(pnpm add:*)",
      "Bash(npm run build:*)",
      "Bash(timeout:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(gtimeout:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Skill(zcf:init-project)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/ccline/ccline",
    "padding": 0
  },
  "outputStyle": "engineer-professional",
  "alwaysThinkingEnabled": true
}
