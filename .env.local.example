# 本地开发私有变量模板。.gitignore 只挡 .env / .env.local 本尊，本模板入库。
# 用法：cp .env.local.example .env.local 后填真值；.env.local 不会被 git 跟踪。
# 加载：scripts/start_node.sh 先 .env 再 .env.local（同名后者覆盖前者）。
# 注意：IMBOYENV / HTTP_PORT 由启动参数与调用方环境决定，写了也会被忽略。
# `IMBOYENV=local make run`（erlang.mk 路径）的密钥由 Makefile 从本文件导出。

# ─── LLM 密钥（config 以 {env, <<"VAR">>} 占位、运行时 os:getenv 解析）────
# 名字写错不报错，只会在触发对应能力时静默降级 error_code=provider_unavailable。

# 智谱 BigModel（墨芽 AI 回课）：https://open.bigmodel.cn → API Keys
# 形如 <id>.<secret>（含点号，约 49 字符）
BIGMODEL_API_KEY=

# 火山方舟（按需，sys config 的 ark 条目）
ARK_API_KEY=

# 阿里云百炼（按需，sys config 的 bailian 条目）
BAILIAN_API_KEY=
