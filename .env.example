# IMBoy 本地开发环境变量 / Local development environment
# 复制为 .env 并填入实际值
# cp .env.example .env
#
# 本地入口：bash scripts/dev_setup.sh；生产安装使用 deploy/.env.example。
# 填写两个 PG 密码；脚本只生成缺失的 Garage / edge / LiveKit 内部密钥，不改已有密码。
# Fill both PG passwords; setup preserves existing credentials and data.

# ─── 本地入口与镜像 / Local endpoints and images ─────────────
# Default builds current backend + pinned frontend source. No host Erlang/Bun needed.
# Prepared images: override BACKEND_IMAGE / ADMIN_IMAGE / WIDGET_IMAGE and use --no-build.
# BACKEND_IMAGE=your-registry/imboy-backend:verified-tag
# ADMIN_IMAGE=your-registry/imboy-admin:verified-tag
# WIDGET_IMAGE=your-registry/imboy-widget:verified-tag
# IMBOY_FRONTEND_CONTEXT=../imboy-admin-frontend
IMBOY_BIND_ADDR=127.0.0.1
NGINX_HTTP_PORT=8080
API_DOMAIN=api.localhost
ADMIN_DOMAIN=admin.localhost
CS_WIDGET_DOMAIN=cs.localhost
RTC_DOMAIN=rtc.localhost
FILES_DOMAIN=files.localhost
IMBOY_BASE_URL=http://${API_DOMAIN}:${NGINX_HTTP_PORT}
IMBOY_WS_URL=ws://${API_DOMAIN}:${NGINX_HTTP_PORT}/api/v1/ws
# IMBOY_API_HOST_PORT=9800
# GARAGE_S3_PORT=3900
# --infra-only sets API_UPSTREAM=host.docker.internal:9800 for host source debugging.
# API_UPSTREAM=imboy_backend:9800
# EDGE_UPSTREAM=imboy_edge:13990

IMBOY_PRODUCT_EXPERIENCE=chat
# Optional files must exist inside the backend runtime volume; see local guide.
# IMBOY_EB_ENTERPRISE_KEYRING_FILE=/opt/imboy/priv_runtime/enterprise_keyring.json
IMBOY_EDGE_INTERNAL_TOKEN=
# Separate cleanup LOGIN (optional locally; never reuse the API database user).
# IMBOY_DIRECT_CLEANUP_PG_USER=
# IMBOY_DIRECT_CLEANUP_PG_PASSWORD=

# LiveKit is opt-in (--with-livekit); media defaults to this computer only.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=127.0.0.1
IMBOY_LIVEKIT_WS_URL=ws://${RTC_DOMAIN}:${NGINX_HTTP_PORT}
IMBOY_LIVEKIT_API_KEY=${LIVEKIT_API_KEY}
IMBOY_LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET}

# ─── 运行环境 ─────────────────────────────────────────────
# 可选值: local | dev | pro | prod
IMBOYENV=local

# HTTP 服务端口（可选，默认使用 sys.config 中的值）
# HTTP_PORT=9800

# ─── 安全密钥 [生产必填 / dev 可留空] ────────────────────
# 行为规则：
#   - dev/local: 任意以下变量留空，启动时使用稳定默认值（详见 imboy_app.erl）
#   - pro/prod : 必须显式赋值，否则 imboy_app:validate_runtime_config/0 fail-fast

# JWT 签名密钥 (binary 32 字节) — 推荐 `openssl rand -base64 32`
IMBOY_JWT_KEY=

# PostgreSQL 数据 AES 加密密钥 (binary 32 字节)
IMBOY_POSTGRE_AES_KEY=

# 管理后台 Cookie 签名密钥 (jwt_key 为空时的 fallback)
IMBOY_ADM_COOKIE_SECRET=

# 历史 MD5 密码盐值（一旦投产不可变更）
IMBOY_PASSWORD_SALT=

# 客户端 /v1/init 响应 AES-256-CBC 密钥 / IV
#   key 必须 32 字节、iv 必须 16 字节
#   dev/local 留空 → 使用 ensure_solidified_keys/0 的稳定默认值（与 Flutter 硬编码一致）
IMBOY_SOLIDIFIED_KEY=
IMBOY_SOLIDIFIED_KEY_IV=

# 登录 RSA 密钥文件路径（PEM 格式），dev/local 留空 → 使用 priv/dev_keys/ 持久化默认值
#   生产生成示例：
#     openssl genrsa -out /etc/imboy/keys/login_rsa_priv.pem 2048
#     openssl rsa   -in  /etc/imboy/keys/login_rsa_priv.pem -pubout \
#                   -out /etc/imboy/keys/login_rsa_pub.pem
IMBOY_LOGIN_RSA_PUB_KEY_FILE=
IMBOY_LOGIN_RSA_PRIV_KEY_FILE=
# 极光认证 RSA 私钥（可选，留空则复用 login_rsa_priv_key_file）
IMBOY_JVERIFICATION_RSA_PRIV_KEY_FILE=

# 生产强制开启 API 签名校验（dev/local 可留空使用 sys.config 默认）
IMBOY_API_AUTH_SWITCH=on

# 推送 / 短信凭据（仅在对应功能开启时强制要求）
IMBOY_JPUSH_APP_KEY=
IMBOY_JPUSH_MASTER_SECRET=
IMBOY_YJSMS_ACCOUNT=
IMBOY_YJSMS_SECRET=

# ─── PostgreSQL 数据库 [必填] ─────────────────────────────
# 应用连接（imboy_app:start/2 时通过 imboy_env.erl 注入）
IMBOY_PG_HOST=127.0.0.1
IMBOY_PG_PORT=4323
IMBOY_PG_USERNAME=imboy_user
IMBOY_PG_PASSWORD=
IMBOY_PG_DATABASE=imboy_v1

# ─── docker-compose dev profile（可选）────────────────────
# docker compose --profile dev up -d 时使用，默认值见 docker-compose.yml
# IMBOY_PG_HOST_PORT=4323

# ─── docker-compose pro profile [生产必填] ────────────────
# docker compose --profile prod up -d 时使用
IMBOY_PG_PRO_USERNAME=imboy_user
IMBOY_PG_PRO_PASSWORD=
IMBOY_PG_PRO_DATABASE=imboy_pro
# For the former pro data directory, set both values explicitly.
# IMBOY_PROD_PG_DATA_DIR=/data/docker/pro_imboy_pg18
# PG_PORT=5181

# ─── SMTP 邮件（可选，不使用邮件功能时无需配置）──────────
# IMBOY_SMTP_RELAY=smtp.qq.com
# IMBOY_SMTP_USERNAME=
# IMBOY_SMTP_PASSWORD=

# ─── 百度千帆 AI（可选，不使用 AI 功能时无需配置）────────
# IMBOY_QIANFAN_API_KEY=
# IMBOY_QIANFAN_SECRET_KEY=
# IMBOY_QIANFAN_AUTH_ACCESS_KEY=
# IMBOY_QIANFAN_AUTH_SECRET_KEY=

# ─── 智谱 BigModel（墨芽 AI 回课用的多模态模型）[启用 AI 回课必填] ────
# 变量名**不加 IMBOY_ 前缀**（与上面千帆那批不同）：它由 config 里
# llm_providers 的 api_key => {env, <<"BIGMODEL_API_KEY">>} 经
# src/lib/imboy_llm_registry.erl 的 resolve_env/1 → os:getenv/1 直读。
# 名字写错不会报错，只会静默降级成 error_code=provider_unavailable。
# 取值：https://open.bigmodel.cn → API Keys → 形如 <id>.<secret>（含点号，约 49 字符）
# 本地开发请写进 .env.local（模板见 .env.local.example，由 scripts/start_node.sh 自动加载）；
# 本文件供 docker-compose / 生产环境使用。
BIGMODEL_API_KEY=

# ─── 阿里云短信（可选，不使用短信功能时无需配置）────────
# IMBOY_SMS_KEY_ID=
# IMBOY_SMS_KEY_SECRET=

# ─── 集群节点 / Cluster nodes ───────────────────────────
# 本地显式单节点；JSON [] 清除配置模板中的示例节点。宿主调试也读取此值。
# Explicit JSON takes precedence over legacy CLUSTER_NODES.
IMBOY_CLUSTER_NODES='[]'
# 集群使用真实节点 JSON 数组；未设置或空字符串保留原应用配置。
# IMBOY_CLUSTER_NODES='["imboy1@10.0.0.1","imboy2@10.0.0.2"]'

# ─── Garage S3 对象存储 ───────────────────────────────────────────
IMBOY_GARAGE_ENDPOINT=http://127.0.0.1:3900
IMBOY_GARAGE_BUCKET=imboy
IMBOY_GARAGE_PUBLIC_BUCKET=imboy-public
IMBOY_GARAGE_PUBLIC_ENDPOINT=http://${API_DOMAIN}:${NGINX_HTTP_PORT}/s3
IMBOY_GARAGE_PUBLIC_BASE_URL=http://${FILES_DOMAIN}:${NGINX_HTTP_PORT}
IMBOY_ATTACHMENT_REGISTRY_FROM_GARAGE=true
GARAGE_RPC_SECRET=
IMBOY_GARAGE_ACCESS_KEY=
IMBOY_GARAGE_SECRET_KEY=

# ─── TSID V10：纯内存实体游标，无状态目录/fence/bootstrap ──────────
# 同一部署所有实例须使用不同的 (dc_id,node_id)，且 dc_bits 全集群一致。
# IMBOY_TSID_DC_ID=1
# IMBOY_TSID_NODE_ID=1
# IMBOY_TSID_DC_BITS=3
# IMBOY_TSID_CAPACITY_WAIT_TIMEOUT_MS=100
# IMBOY_TSID_MAX_CLOCK_DRIFT_MS=5000
