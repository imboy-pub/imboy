# IMBoy 后端环境变量配置模板
# 复制为 .env 并填入实际值
# cp .env.example .env
#
# 生产环境必须配置带 [必填] 标记的变量
# 开发环境可以使用 sys.local.config / sys.dev.config 中的默认值

# ─── 运行环境 ─────────────────────────────────────────────
# 可选值: local | dev | pro | prod
IMBOYENV=pro

# HTTP 服务端口（可选，默认使用 sys.config 中的值）
# HTTP_PORT=9800

# ─── 安全密钥 [生产必填 / dev 可留空] ────────────────────
# 行为规则：
#   - dev/local: 任意以下变量留空，启动时使用稳定默认值（详见 imboy_app.erl）
#   - pro/prod : 必须显式赋值，否则 imboy_app:validate_runtime_config/0 fail-fast

# JWT 签名密钥 (binary 32 字节) — 推荐 `openssl rand -base64 32`
IMBOY_JWT_KEY=

# PostgreSQL 数据 AES 加密密钥 (binary 32 字节)
IMBOY_POSTGRE_AES_KEY=

# 管理后台 Cookie 签名密钥 (jwt_key 为空时的 fallback)
IMBOY_ADM_COOKIE_SECRET=

# 历史 MD5 密码盐值（一旦投产不可变更）
IMBOY_PASSWORD_SALT=

# 客户端 /v1/init 响应 AES-256-CBC 密钥 / IV
#   key 必须 32 字节、iv 必须 16 字节
#   dev/local 留空 → 使用 ensure_solidified_keys/0 的稳定默认值（与 Flutter 硬编码一致）
IMBOY_SOLIDIFIED_KEY=
IMBOY_SOLIDIFIED_KEY_IV=

# 登录 RSA 密钥文件路径（PEM 格式），dev/local 留空 → 使用 priv/dev_keys/ 持久化默认值
#   生产生成示例：
#     openssl genrsa -out /etc/imboy/keys/login_rsa_priv.pem 2048
#     openssl rsa   -in  /etc/imboy/keys/login_rsa_priv.pem -pubout \
#                   -out /etc/imboy/keys/login_rsa_pub.pem
IMBOY_LOGIN_RSA_PUB_KEY_FILE=
IMBOY_LOGIN_RSA_PRIV_KEY_FILE=
# 极光认证 RSA 私钥（可选，留空则复用 login_rsa_priv_key_file）
IMBOY_JVERIFICATION_RSA_PRIV_KEY_FILE=

# 生产强制开启 API 签名校验（dev/local 可留空使用 sys.config 默认）
IMBOY_API_AUTH_SWITCH=on

# WebRTC TURN 共享密钥（仅在配置 eturnal_turn_urls 时强制要求）
IMBOY_ETURNAL_SECRET=

# 推送 / 短信凭据（仅在对应功能开启时强制要求）
IMBOY_JPUSH_APP_KEY=
IMBOY_JPUSH_MASTER_SECRET=
IMBOY_YJSMS_ACCOUNT=
IMBOY_YJSMS_SECRET=

# ─── PostgreSQL 数据库 [必填] ─────────────────────────────
# 应用连接（imboy_app:start/2 时通过 imboy_env.erl 注入）
IMBOY_PG_HOST=127.0.0.1
IMBOY_PG_PORT=5432
IMBOY_PG_USERNAME=imboy_user
IMBOY_PG_PASSWORD=
IMBOY_PG_DATABASE=imboy_v1

# ─── docker-compose dev profile（可选）────────────────────
# docker compose --profile dev up -d 时使用，默认值见 docker-compose.yml
# IMBOY_PG_HOST_PORT=4323

# ─── docker-compose pro profile [生产必填] ────────────────
# docker compose --profile pro up -d 时使用
# IMBOY_PG_PRO_USERNAME=imboy_user
# IMBOY_PG_PRO_PASSWORD=
# IMBOY_PG_PRO_DATABASE=imboy_pro
# IMBOY_PG_PRO_HOST_PORT=5181

# ─── Redis（可选，未使用 Redis 时无需配置）────────────────
# IMBOY_REDIS_HOST=127.0.0.1
# IMBOY_REDIS_PORT=6379
# IMBOY_REDIS_PASSWORD=

# ─── SMTP 邮件（可选，不使用邮件功能时无需配置）──────────
# IMBOY_SMTP_RELAY=smtp.qq.com
# IMBOY_SMTP_USERNAME=
# IMBOY_SMTP_PASSWORD=

# ─── 百度千帆 AI（可选，不使用 AI 功能时无需配置）────────
# IMBOY_QIANFAN_API_KEY=
# IMBOY_QIANFAN_SECRET_KEY=
# IMBOY_QIANFAN_AUTH_ACCESS_KEY=
# IMBOY_QIANFAN_AUTH_SECRET_KEY=

# ─── 阿里云短信（可选，不使用短信功能时无需配置）────────
# IMBOY_SMS_KEY_ID=
# IMBOY_SMS_KEY_SECRET=

# ─── 集群节点（可选，单节点部署时无需配置）────────────────
# 格式: 逗号分隔的节点名列表
# CLUSTER_NODES=imboy1@10.0.0.1,imboy2@10.0.0.2

# ─── Garage S3 对象存储 ───────────────────────────────────────────
IMBOY_GARAGE_ENDPOINT=http://127.0.0.1:3900
IMBOY_GARAGE_BUCKET=imboy
IMBOY_GARAGE_ACCESS_KEY=
IMBOY_GARAGE_SECRET_KEY=
