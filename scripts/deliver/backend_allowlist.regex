# Positive backend source-delivery categories. Update the product manifest too.
^(src|include|priv|proto|api|docker|test|scripts)/
^(erlang\.mk|Makefile|relx\.config|elvis\.config|erlang_ls\.config|rebar\.lock|dialyzer\.baseline|Dockerfile)$
^(README(\.en)?|RELEASES|CHANGELOG|SECURITY|SUPPORT|CONTRIBUTING|CODE_OF_CONDUCT|ROADMAP)\.md$
^(LICENSE|VERSION|\.env\.example|\.env\.local\.example)$
^config/(sys\.config\.example|vm\.args|cron\.config|nginx-imboy\.conf|product-feature-manifest\.json)$
^config/product-feature-manifests/
^deploy/(\.env\.example|ops\.env\.example|README\.md|install\.sh|preflight\.sh|docker-compose\.(community|demo|observability|widget|healthcheck|uptrace)\.yml|docker-compose\.secrets\.example\.yml)$
^deploy/(nginx|prometheus|loki|grafana|alertmanager|promtail|uptrace|cron|widget)/
^docs/(reference|concepts|api-contracts|legal|adr|tutorials|explanation|architecture|compliance|product|ops|deliver)/
^docs/guides/(operations|release|security|migrations)/
^docs/(glossary|README|CONVENTIONS)\.md$
^docs/runbooks/bot-webhook-aead-key\.md$
^docs/brand/logo/imboy_logo_2474E5_0512\.png$
