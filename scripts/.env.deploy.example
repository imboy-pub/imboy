# =============================================================================
# imboy 部署配置模板
# 复制为 .env.deploy 并填写真实值，该文件已加入 .gitignore
# Copy to .env.deploy and fill in real values — this file is .gitignore'd
# =============================================================================

# ── 服务器 SSH ────────────────────────────────────────────────────────────────
SERVER_HOST=106.53.76.53
SERVER_PORT=32
SERVER_USER=root

# ── Erlang 后端 ───────────────────────────────────────────────────────────────
# 要发布的版本号（与 VSN 文件一致）
DEPLOY_VSN=1.0.0-rc.1
# 服务器上项目工作目录（含 Makefile、config/）
DEPLOY_PROJECT_DIR=/www/wwwroot/imboy-api
# 部署分支
DEPLOY_BRANCH=main
# 蓝绿端口（当前生产跑哪个就填哪个为 BLUE）
DEPLOY_BLUE_PORT=9800
DEPLOY_GREEN_PORT=9801
# Erlang 节点 cookie
DEPLOY_COOKIE=imboycookie
# Nginx upstream 配置文件路径
NGINX_CONF=/www/server/panel/vhost/nginx/pro.imboy.pub.conf
# 部署完成后是否立即停旧节点（false = 保留旧节点可快速回滚）
DEPLOY_STOP_OLD=true

# ── 管理后台 Admin Frontend ───────────────────────────────────────────────────
# 本地构建产物目录（相对于 imboy/ 仓库根）
ADMIN_BUILD_DIR=../imboy-admin-frontend
# 服务器上静态文件目录
ADMIN_REMOTE_DIR=/www/wwwroot/prodadm.imboy.pub

# ── 数据库 ────────────────────────────────────────────────────────────────────
DB_CONTAINER=prod_imboy_pg18
DB_NAME=imboy_pro
DB_USER=imboy_user
# 数据库端口（Docker 映射的宿主机端口）
DB_PORT=5182
