# =============================================================================
# imboy 部署配置模板
# 复制为 .env.deploy，或保存为仓库外的客户配置并通过 --env-file 指定。
# Copy to .env.deploy, or keep per-customer files outside the repository.
# =============================================================================

# ── 服务器 SSH ────────────────────────────────────────────────────────────────
SERVER_HOST=106.53.76.53
SERVER_PORT=32
SERVER_USER=root

# ── Erlang 后端 ───────────────────────────────────────────────────────────────
# 要发布的版本号；--local 发布会自动同步 VERSION、relx.config 和生产 relx 配置
DEPLOY_VSN=1.0.0-rc.1
# 生产 release 配置文件（相对于 imboy 仓库根）
DEPLOY_RELX_CONFIG=relxpro.config
# Erlang 节点名（不含 @host）；留空则按当前时间自动生成
DEPLOY_NODE_NAME=
# 每套客户独立的 32 字节 Ed25519 raw 公钥；相对路径按本 env 文件目录解析
# 对应私钥只能留在受控签名机，部署脚本不会上传私钥。
DEPLOY_PLUGIN_TRUSTED_PUBLIC_KEY_FILE=~/.config/imboy/customer/plugin-signing-public.raw
# 服务器上项目工作目录（含 Makefile、config/）
DEPLOY_PROJECT_DIR=/www/wwwroot/imboy-api
# 部署分支
DEPLOY_BRANCH=main
# 蓝绿端口（当前生产跑哪个就填哪个为 BLUE）
DEPLOY_BLUE_PORT=9800
DEPLOY_GREEN_PORT=9801
# Erlang 节点 cookie
DEPLOY_COOKIE=imboycookie
# Nginx upstream 配置文件路径
NGINX_CONF=/www/server/panel/vhost/nginx/pro.imboy.pub.conf
# Admin API vhost 配置文件路径（其中 proxy_pass 指向蓝绿端口）
PRODADM_CONF=/www/server/panel/vhost/nginx/prodadm.imboy.pub.conf
# 部署完成后是否立即停旧节点（false = 保留旧节点可快速回滚）
DEPLOY_STOP_OLD=true
# 切流前 expand 迁移清单（空格分隔）。留空 = 自动模式：
# schema 升级由切流后的 `make ctl db migrate`（erlang_migrate）按台账自动判断并登记。
# 显式配置 = 对指定可加迁移在切流前 psql 直跑（受控 expand 护航，boundary 迁移专用）。
DEPLOY_EXPAND_MIGRATIONS=""
# 销售版默认启用严格门禁与强制 E2EE；社区部署需同时改为 false / disabled。
DEPLOY_SALES_RELEASE=true
DEPLOY_E2EE_MODE=required

# ── 管理后台 Admin Frontend ───────────────────────────────────────────────────
# 本地构建产物目录（相对于 imboy/ 仓库根）
ADMIN_BUILD_DIR=../imboy-admin-frontend
# 服务器上静态文件目录
ADMIN_REMOTE_DIR=/www/wwwroot/prodadm.imboy.pub

# ── 数据库 ────────────────────────────────────────────────────────────────────
DB_CONTAINER=prod_imboy_pg18
DB_NAME=imboy_pro
DB_USER=imboy_user
# 数据库端口（Docker 映射的宿主机端口）
DB_PORT=5182
