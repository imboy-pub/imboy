# =============================================================================
# imboy 部署配置模板
# 复制为 .env.deploy，或保存为仓库外的客户配置并通过 --env-file 指定。
# Copy to .env.deploy, or keep per-customer files outside the repository.
# =============================================================================

# ── 服务器 SSH ────────────────────────────────────────────────────────────────
SERVER_HOST=106.53.76.53
SERVER_PORT=32
SERVER_USER=root

# ── Erlang 后端 ───────────────────────────────────────────────────────────────
# 要发布的版本号；--local 发布会自动同步 VERSION、relx.config 和生产 relx 配置
DEPLOY_VSN=1.0.0-rc.1
# 生产 release 配置文件（相对于 imboy 仓库根）
DEPLOY_RELX_CONFIG=relxpro.config
# Erlang 节点名（不含 @host）；留空则按当前时间自动生成
DEPLOY_NODE_NAME=
# 每套客户独立的 32 字节 Ed25519 raw 公钥；相对路径按本 env 文件目录解析
# 对应私钥只能留在受控签名机，部署脚本不会上传私钥。
DEPLOY_PLUGIN_TRUSTED_PUBLIC_KEY_FILE=~/.config/imboy/customer/plugin-signing-public.raw
# 服务器上项目工作目录（含 Makefile、config/）
DEPLOY_PROJECT_DIR=/www/wwwroot/imboy-api
# 部署分支
DEPLOY_BRANCH=main
# 蓝绿端口（当前生产跑哪个就填哪个为 BLUE）
DEPLOY_BLUE_PORT=9800
DEPLOY_GREEN_PORT=9801
# 从旧单节点首次迁入蓝绿时填写旧 upstream 端口；首次切流后该值不再参与。
DEPLOY_LEGACY_PORT=
# legacy 已停机时的恢复点；仅作首次割接断点续发，必须是 /usr/local/imboy-<版本>-<节点>。
DEPLOY_LEGACY_RELEASE_DIR=
# Erlang 节点 cookie
DEPLOY_COOKIE="<your-random-cookie>"
# Nginx upstream 配置文件路径
NGINX_CONF=/www/server/panel/vhost/nginx/pro.imboy.pub.conf
# API 对外域名（省略时从 NGINX_CONF 文件名推导）
API_DOMAIN=pro.imboy.pub
# Admin API vhost 配置文件路径（其中 proxy_pass 指向蓝绿端口）
PRODADM_CONF=/www/server/panel/vhost/nginx/prodadm.imboy.pub.conf
# 部署完成后是否立即停旧节点（false = 保留旧节点可快速回滚）
DEPLOY_STOP_OLD=true
# TSID 首次割接参数。常规部署留空并沿用 sys.config；历史库首次接入 durable
# generator 时配置新的持久目录，脚本会先停旧 writer，再解析 manual_floor=now。
DEPLOY_TSID_STATE_DIR=
# 同一 DC 内两色必须使用不同 node_id；dc_bits=3 时范围 0..127。
DEPLOY_TSID_BLUE_NODE_ID=1
DEPLOY_TSID_GREEN_NODE_ID=2
DEPLOY_TSID_BOOTSTRAP_MODE=
DEPLOY_TSID_BOOTSTRAP_FLOOR_UNIX_MS=
# 仅在首次割接中设置固定确认值 I-CONFIRM-OLD-WRITER-STOPPED。
DEPLOY_TSID_BOOTSTRAP_LEGACY_ACK=
# catalog digest 显式重绑专用；普通部署留空。
DEPLOY_TSID_BOOTSTRAP_REBIND_ACK=
# 切流前 expand 迁移清单（空格分隔）。留空 = 自动模式：
# schema 升级由切流后的 `make ctl db migrate`（erlang_migrate）按台账自动判断并登记。
# 显式配置 = 对指定可加迁移在切流前 psql 直跑（受控 expand 护航，boundary 迁移专用）。
DEPLOY_EXPAND_MIGRATIONS=""
# 销售版默认启用严格门禁与强制 E2EE；社区部署需同时改为 false / disabled。
DEPLOY_SALES_RELEASE=true
DEPLOY_E2EE_MODE=required

# ── 管理后台 Admin Frontend ───────────────────────────────────────────────────
# 本地构建产物目录（相对于 imboy/ 仓库根）
ADMIN_BUILD_DIR=../imboyadmin
# 服务器上静态文件目录
ADMIN_REMOTE_DIR=/www/wwwroot/prodadm.imboy.pub
# Admin 对外域名（省略时从 ADMIN_REMOTE_DIR basename 推导）
ADMIN_DOMAIN=prodadm.imboy.pub

# ── 数据库 ────────────────────────────────────────────────────────────────────
DB_CONTAINER=prod_imboy_pg18
DB_NAME=imboy_pro
DB_USER=imboy_user
# 数据库端口（Docker 映射的宿主机端口）
DB_PORT=5182

# ── 客服托管 Widget（cs 组件 / all 全量，CSD-CLI-01）─────────────────────────
# 合同: hosted-widget-contract-v1 §S7；文档: docs/guides/operations/deployment/customer-service-widget.md
# Widget 网关第三域名（须为合法 FQDN；与 API/Admin 域两两不同，由标准部署 preflight 校验）
CS_WIDGET_DOMAIN=cs.example.com
# 本地 Widget 构建产物目录（相对 imboy 仓库根）。
# cs 每次都在其上级源码仓执行 bun run build:widget，并校验 manifest.source_head 与 clean Git HEAD 一致。
CS_BUILD_DIR=../imboy-admin/dist-widget
# 服务器上不可变 release 根目录：必须位于 /www/wwwroot/ 批准根内，
# 且已预先创建并放置 .imboy-cs-root 标记文件（marker 缺失时 fail-closed）
CS_REMOTE_ROOT=/www/wwwroot/cs.example.com
# CS vhost 配置文件路径（Widget 激活时原子替换；后续 API 蓝绿切流会与 API/Admin vhost 同步切换）
CS_NGINX_CONF=/www/server/panel/vhost/nginx/cs.example.com.conf
# CS 域证书（远端路径；fullchain 与 key 必须存在、非空且公钥配对）
CS_CERT_FULLCHAIN=/etc/letsencrypt/live/cs.example.com/fullchain.pem
CS_CERT_KEY=/etc/letsencrypt/live/cs.example.com/privkey.pem
# REAL_SMOKE 使用的第三方宿主页 origin（http(s)://host[:port]，无路径；须已接入 Widget snippet）
CS_SMOKE_SHOP_ORIGIN=https://shop.example.com
