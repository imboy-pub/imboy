# B-25：Alertmanager 通知渠道取值（收件邮箱 / webhook URL）。
# webhook URL 本身就是凭据，谁拿到谁就能往群里发消息 —— 绝不入库。
# 仓库里只保留 alertmanager.env.example（全部留空）与模板。
deploy/alertmanager/alertmanager.env
elvis-output.txt

# git worktree 兼容 symlink：worktree 根 `ln -s . imboy`，配合 Makefile
# eunit-local 的 -pa imboy/ebin 让 code:priv_dir(imboy) 可解析（worktree
# 根目录名是 rg-*，不带 imboy/ebin 结构）；主树无此文件，零副作用。
/imboy
docs/plans
docs/planning
tmp

# REST CT runner runtime artifacts (untracked by design)
/.ct/
/config/sys.config
# Makefile eunit-local 生成的 PG relay 端口替换副本（同样 untracked by design）
/config/sys.eunit-relay.config
# seat-console-embed run SC-BE：sc153_eunit scratch 库的 eunit 配置
# （从 sys.config.example 派生、database=>"sc153_eunit"；untracked by design——
# 与 sys.local.config 同类，非产品配置）
/config/sys.sc153.config
# phase1 交付质量 run（2026-10-07）：本 run 隔离库 imboy_p1_* 的 eunit 配置
# （从 sys.local.config 派生、database 替换为 run 库；与 sys.local.config 同类
# 非产品配置，untracked by design）
/config/sys.p1-run.config
/config/sys.p1-boot.config
# TSID durable fence 双槽文件（clock.a/b + manifest + tsid.bootstrap）：
# 本机节点时钟状态（TSID-05/07 部署口径为持久卷挂载点 priv/tsid），按机
# 各自演化、绝不入库；eunit 轨道已隔离到 /tmp/imboy-eunit-tsid-<pid>。
/priv/tsid/
# S3 门加固（2026-10-07 S3-SEC-AUDIT）：上述精确路径不匹配带端口后缀的变体，
# evidence 目录含 run-configs 同源凭据副本与未检二进制件——整体不入仓
/config/sys.eunit-relay*.config
# fixture 修复回归（WS-FIXTURE-FIX）与 soak 压测的本地配置副本：与
# sys.eunit-relay 同源派生（local 凭据测试值），同口径 untracked by design；
# AI 密钥经 {env, ...} 环境变量解析，无明文真实密钥，但仍不入仓
/config/sys.fixturefix*.config
/config/sys.soak*.config
