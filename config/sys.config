[
    {imboy, [
        % http服务端口
        {http_port, 9800}
        %, {host, <<"local.imboy.pub">>}
        , {host, '_'}
        % start_mode 包含的值 quic | tls | http
        , {start_mode, http}
        %, {cacertfile, "/ssl/dev.imboy.pub_chain.csr"}
        %, {certfile, "/ssl/dev.imboy.pub_public.crt"}
        %, {keyfile, "/ssl/dev.imboy.pub.key"}
        , {cacertfile, "/ssl/chain.csr"}
        , {certfile, "/ssl/public.crt"}
        , {keyfile, "/ssl/server.key"}
        , {base_url, <<"https://dev.imboy.pub">>}
        % CORS 白名单（仅这些 Origin 允许跨域携带凭证）
        % 开发环境支持 localhost 任意端口
        , {cors_allowed_origins, [
            <<"https://dev.imboy.pub">>,
            <<"http://localhost:8082">>,
            <<"http://localhost:56164">>
        ]}
        % 开发环境允许 localhost 任意端口（正则匹配）
        , {cors_allow_localhost, true}

        % jwt_key binary 32
        , {jwt_key, <<>>}

        %% 管理后台 Cookie 签名密钥（jwt_key 为空时的 fallback）
        %% 生产环境通过 IMBOY_ADM_COOKIE_SECRET 环境变量设置
        , {adm_cookie_secret, ""}
        % 用于postgresql 存储数据的AES密钥 Key binary 32
        , {postgre_aes_key, <<>>}

        % 离线消息阈值配置 - 超过此数量的离线消息将发送pull通知而非直接推送
        , {offline_msg_threshold, 10}

        % 消息永久存储开关（方案 B：conv_seq 游标）
        % true  = 写入 msg_store 表，支持历史查询 / 审计
        % false = 不写 msg_store，ACK 后投递表即删除（省存储）
        , {msg_archive_enabled, true}

        % 频道消息撤回窗口（秒），默认 120 秒；设置为 0 表示不限制时间窗
        , {channel_revoke_window_seconds, 120}

        % 推送通知配置（FCM / APNs）
        % 暂停点：需要配置真实的 FCM project_id 和 access_token
        , {push, [
            {enabled, false}  % 总开关，true 启用推送
            , {fcm_project_id, "your-firebase-project-id"}
            , {fcm_access_token, "your-oauth2-access-token"}
            % APNs 配置（iOS 推送）
            , {apns_key_id, ""}
            , {apns_team_id, ""}
            , {apns_bundle_id, "pub.imboy.app"}
        ]}

        % WebRTC ICE Server 配置
        % 客户端通过 /config/ice_servers API 获取
        , {ice_servers, [
            #{urls => "stun:stun.l.google.com:19302"}
            , #{urls => "stun:stun1.l.google.com:19302"}
            % TURN 服务器（需部署 coturn，取消注释并填入真实地址和密钥）
            % , #{urls => "turn:turn.example.com:3478",
            %     username => "imboy",
            %     credential => "your-turn-secret"}
            % , #{urls => "turns:turn.example.com:5349",
            %     username => "imboy",
            %     credential => "your-turn-secret"}
        ]}

        % TSID 分布式ID生成器配置
        , {tsid_dc_id, 1}             % 数据中心ID (0-7, dc_bits=3 时支持 8 个DC)
        , {tsid_node_id, 1}           % 节点ID (0-127, dc_bits=3 时每DC支持 128 个节点)
        , {tsid_dc_bits, 3}           % DC位数 (全集群必须统一)

        % 账号注销自动清理配置
        , {user_deletion_enabled, false}           % 启用自动删除（默认 false）
        , {user_deletion_retention_days, 60}       % 保留天数，申请注销后 60 天自动删除
        , {user_deletion_interval, 86400000}       % 扫描间隔，默认 24 小时
        , {user_deletion_batch_size, 10}           % 每批处理上限

        % 集群节点配置，用于节点间通信和集群管理
        % 示例: ['imboy1@127.0.0.1', 'imboy2@127.0.0.1']
        % 也可以通过环境变量 CLUSTER_NODES 设置
        , {cluster_nodes, ['node1@127.0.0.1', 'node2@127.0.0.1']}

        ,  {guanco, [
           {ollama_api_url, "http://localhost:11434"},
           {pool_size, 5},
           {max_overflow, 10}
         ]}

        % smtp 配置参考 https://github.com/gen-smtp/gen_smtp
        , {smtp_option, [
            {relay, "smtp.qq.com"}
            , {ssl, true}
            , {auth,always}
            , {trace_fun, fun io:format/2}
            , {username, ""}
            , {password, ""}
        ]}

        , {sms, [
            {switch, <<"off">>}
            , {default_code, <<"6666">>}
            , {platform, <<"aliyun">>}
            , {<<"aliyun">>, [
                {sign_name, <<"xxx"/utf8>>}
                , {template_code, <<>>}
                , {key_id, <<>>}
                , {key_secret, <<>>}
                , {region_id, <<"cn-shenzhen">>}
            ]}
        ]}

        , {sql_driver, pgsql}
        , {pg_conf
            , #{name => pgsql,
                max_count => 80,
                init_count => 5,
                start_mfa => {
                    epgsql
                    , connect
                    , [
                        #{
                            host => "localhost"
                            , username => "imboy_user"
                            %% 生产环境通过 IMBOY_PG_PASSWORD 环境变量设置
                            , password => ""
                            , database => "imboy_v1"
                            , port => 5432
                            , ssl => false
                            , timeout => 4000
                            ,  codecs => [{epgsql_codec_rfc3339_bin, []}]
                        }
                    ]
                }
            }
        }
        %% 能够创建表删除表的超级数据库用户
        %% 生产环境通过 IMBOY_PG_* 环境变量设置
        , {super_account, #{
            host => "localhost"
            , username => "imboy_user"
            , password => ""
            , database => "imboy_v1"
            , port => 5432
            , ssl => false
            , timeout => 4000
        }}
        %% 这里用绝对路径
        %% 注意：code:priv_dir(imboy) 已包含 /priv，所以只需 $PROJECT_DIR/migrations
        , {scripts_path, "$PROJECT_DIR/migrations"}

        %% 是否在启动时自动加载额外配置文件
        , {auto_load_configs, true}
        %% 配置文件管理
        %% 指定额外的配置文件路径，这些配置会在应用启动时动态加载
        , {config_files, [
            {debug_config, "config/debug.config"},
            {cron_config, "config/cron.config"}
        ]}

        % 启用分布式缓存同步功能
        , {dsync_enabled, true}

        %% Depcache settings,
        , {depcache, [
            % maximum size in mbs
            {depcache_memory_max, 100}
        ]}

        , {crontab_jobs, [
            %% {JobName, CrontabSpec, {M, F, A}}
            %% {JobName, CrontabSpec, {M, F, A}, StartDateTime, EndDateTime}
            %% CrontabSpec
            %%  1. "Minute Hour DayOfMonth Month DayOfWeek"
            %%  2. "Second Minute Hour DayOfMonth Month DayOfWeek"
            %%  3. @yearly | @annually | @monthly | @weekly | @daily | @midnight | @hourly | @minutely
            %%  4. @every 1h2m3s

            %% Standard crontab spec without second (default second is 0 not *).
            {crontab_job, "*/15 * * * *", {demo_cron_logic, inspect, ["Runs on 0, 15, 30, 45 minutes"]}},
            %% Extend crontab spec with second.
            {extend_crontab_job, "0 0 1-6/2,18 * * *", {demo_cron_logic, inspect, ["Runs on 1,3,6,18 o'clock"]}},
            %% Crontab spec with alphabet.
            {alphabet_job, "@hourly", {demo_cron_logic, inspect, ["Runs every(0-23) o'clock"]}},
            %% Fixed interval spec.
            {fixed_interval_job, "@every 5m", {demo_cron_logic, inspect, ["Runs every 5 minutes"]}},
            %% Job with startDateTime and EndDateTime. Runs 0-23 o'clock since {11,0,0}.
            {limit_datetime_job, "@hourly", {demo_cron_logic, inspect, ["Runs every(0-23) o'clock"]}, {11, 0, 0}, unlimited},
            %% Job with max run count, default is `unlimited`
            {max_run_count_job, "@daily", {demo_cron_logic, inspect, ["Runs daily"]}, unlimited, unlimited, [{max_count, 1000}]},
            %% Parallel job, singleton default is true.
            {no_singleton_job, "@minutely", {timer, sleep, [61000]}, unlimited, unlimited, [{singleton, false}]}
        ]}
    ]}

    , {throttle, [
        {rates, [
            {refreshtoken, 11, per_minute}
            , {refreshtoken, 5, per_second}
            , {throttle_ws, 22, per_minute}
            , {throttle_ws, 10, per_second}
            , {three_second_once, 1, 3000} % 3 秒 1次
            , {per_hour_once, 1, per_hour}
            , {per_minute_once, 1, per_minute}
            , {api_per_user, 120, per_minute}  % 每用户每分钟 API 调用上限
            , {api_per_ip, 60, per_minute}     % 每 IP 每分钟 API 调用上限
            , {msg_per_user, 60, per_minute}   % 每用户每分钟消息发送上限
        ]}
    ]}
    , {sync, [
        {growl, all},
        {log, all},
        {non_descendants, fix},
        {executable, auto},
        {whitelisted_modules, []},
        {excluded_modules, [
            "deps/*"
        ]},
        {include, ["include"]}
    ]}

    %% Lager Begin %%%
    , {sasl, [
        {utc_log, true},
        {sasl_error_logger, {file, "log/sasl-error.log"}},
        {errlog_type, error},
        {error_logger_mf_dir, "log/sasl"},      % Log directory
        {error_logger_mf_maxbytes, 104857600},   % 100 MB max file size
        {error_logger_mf_maxfiles, 255}           % 255 files max
    ]}
    , {lager, [
        %% 日志根目录（注意：确保该目录有写入权限）
        {log_root, "./log"}
        %% What handlers to install with what arguments
        , {handlers, [
            {lager_console_backend, [{level, info},{formatter, lager_default_formatter},
                {formatter_config, [color, date," ",time, " [", severity, "] ", node,"#",pid, " ", message, "\n"]}]}
            , {lager_file_backend, [
                {file, "error.log"}, {level, error}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
            , {lager_file_backend, [
                {file, "debug.log"}, {level, info}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
        ]}
        , {colored,true} % 启用颜色
        %% 控制台日志颜色配置（仅对lager_default_formatter生效）
        , {colors, [
            {debug,     "\e[0;38m"},  % 灰色
            {info,      "\e[1;32m"},  % 绿色
            {notice,    "\e[1;36m"},  % 青色
            {warning,   "\e[1;33m"},  % 黄色
            {error,     "\e[1;31m"},  % 红色
            {critical,  "\e[1;35m"},  % 紫色
            {alert,     "\e[1;44m"},  % 蓝底白字
            {emergency, "\e[1;41m"}   % 红底白字
        ]}
    ]}
    , {kernel, [
        {start_timer, true}
        , {logger_level, info}
    ]}
    %% Lager End %%%

    , {ecron, [
        {time_zone, local}, %% local or utc
        {global_quorum_size, 1},
        {global_jobs, [
            % 6个星号分别表示 秒，分钟、小时、日、月、周几
            % {global_crontab_job, "*/1 * * * * *", {demo_cron_logic, inspect, ["Runs on 0, 15, 30, 45 seconds"]}}
        ]}
    ]}

    , {kernel, [
        {start_timer, true}
        , {logger_level, all}
    ]}
].
