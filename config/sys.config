%% ============================================================================
%% imboy sys.config — 三段式结构（A. 网络 / B. 业务 / C. 敏感凭据）
%% imboy sys.config — three sections (A. Network / B. Business / C. Secrets)
%%
%% 真相源（Source of Truth）：
%%   1) 业务参数与端口默认值 → 本文件
%%   2) 部署期覆盖（密钥、密码、域名）→ IMBOY_* 环境变量
%%      → 由 src/lib/imboy_env.erl: override_from_env/0 在 boot 时统一注入
%%   3) 运行环境标识（local/dev/prod）→ os env IMBOYENV
%%      → 任何模块统一通过 imboy_env:current/0 获取，不再直接 os:getenv
%%
%% 生产环境只需：
%%   - 设置 IMBOYENV=prod 与 IMBOY_* 必备变量
%%   - 不要修改本文件；如有差异请在 IMBOY_* 中覆盖
%% ============================================================================

[
    {imboy, [
        %% ====================================================================
        %% SECTION A — 网络与服务端口
        %% Section A — Networking & service ports
        %% （部署期可调，重启生效；非敏感）
        %% ====================================================================

        % HTTP 服务端口（蓝绿切换可用 9800/9801）
        {http_port, 9800}
        %, {host, <<"local.imboy.pub">>}
        , {host, '_'}
        % start_mode 包含的值 quic | tls | http
        , {start_mode, http}
        %, {cacertfile, "/ssl/dev.imboy.pub_chain.csr"}
        %, {certfile, "/ssl/dev.imboy.pub_public.crt"}
        %, {keyfile, "/ssl/dev.imboy.pub.key"}
        , {cacertfile, "/ssl/chain.csr"}
        , {certfile, "/ssl/public.crt"}
        , {keyfile, "/ssl/server.key"}
        , {base_url, <<"https://dev.imboy.pub">>}

        % CORS 白名单（仅这些 Origin 允许跨域携带凭证）
        % 开发环境支持 localhost 任意端口
        , {cors_allowed_origins, [
            <<"https://dev.imboy.pub">>,
            <<"http://localhost:8082">>,
            <<"http://localhost:56164">>
        ]}
        % 开发环境允许 localhost 任意端口（正则匹配）
        , {cors_allow_localhost, true}

        %% 客户端 /init 接口返回的 URL 及上传配置
        %% ws_url: WebSocket 连接地址（wss:// 或 ws://）
        , {ws_url, <<"wss://dev.imboy.pub/ws">>}
        , {upload_url, <<>>}
        , {upload_key, <<>>}
        , {upload_scene, <<>>}

        % 集群节点配置，用于节点间通信和集群管理
        % 示例: ['imboy1@127.0.0.1', 'imboy2@127.0.0.1']
        % 也可以通过环境变量 CLUSTER_NODES 设置
        , {cluster_nodes, ['node1@127.0.0.1', 'node2@127.0.0.1']}

        %% ====================================================================
        %% SECTION B — 业务参数（功能开关、阈值、运行时策略）
        %% Section B — Business tunables (feature flags, thresholds, policies)
        %% （跨环境基本一致，按业务需要调整；非敏感）
        %% ====================================================================

        %% API 签名验证开关（<<"on">> | <<"off">>）
        %% 生产环境建议设为 <<"on">>，开发/测试可留 <<"off">>
        , {api_auth_switch, <<"off">>}

        %% login_pwd_rsa_encrypt: 客户端是否对密码做 RSA 加密（<<"on">> | <<"off">>）
        , {login_pwd_rsa_encrypt, <<"off">>}

        % 离线消息阈值配置 - 超过此数量的离线消息将发送pull通知而非直接推送
        , {offline_msg_threshold, 10}

        % 消息永久存储开关（方案 B：conv_seq 游标）
        % true  = 写入 msg_store 表，支持历史查询 / 审计
        % false = 不写 msg_store，ACK 后投递表即删除（省存储）
        , {msg_archive_enabled, true}

        % 频道消息撤回窗口（秒），默认 120 秒；设置为 0 表示不限制时间窗
        , {channel_revoke_window_seconds, 120}

        % TSID 分布式ID生成器配置
        , {tsid_dc_id, 1}             % 数据中心ID (0-7, dc_bits=3 时支持 8 个DC)
        , {tsid_node_id, 1}           % 节点ID (0-127, dc_bits=3 时每DC支持 128 个节点)
        , {tsid_dc_bits, 3}           % DC位数 (全集群必须统一)

        % 账号注销自动清理配置
        , {user_deletion_enabled, false}           % 启用自动删除（默认 false）
        , {user_deletion_retention_days, 60}       % 保留天数，申请注销后 60 天自动删除
        , {user_deletion_interval, 86400000}       % 扫描间隔，默认 24 小时
        , {user_deletion_batch_size, 10}           % 每批处理上限

        % 推送通知配置（FCM / APNs）— 凭据走 SECTION C
        , {push, [
            {enabled, false}  % 总开关，true 启用推送
            , {fcm_project_id, "your-firebase-project-id"}
            , {fcm_access_token, "your-oauth2-access-token"}
            % APNs 配置（iOS 推送）
            , {apns_key_id, ""}
            , {apns_team_id, ""}
            , {apns_bundle_id, "pub.imboy.app"}
        ]}

        % WebRTC ICE Server 配置
        % 客户端通过 /config/ice_servers API 获取
        , {ice_servers, [
            #{urls => "stun:stun.l.google.com:19302"}
            , #{urls => "stun:stun1.l.google.com:19302"}
            % TURN 服务器（需部署 coturn，取消注释并填入真实地址和密钥）
            % , #{urls => "turn:turn.example.com:3478",
            %     username => "imboy",
            %     credential => "your-turn-secret"}
            % , #{urls => "turns:turn.example.com:5349",
            %     username => "imboy",
            %     credential => "your-turn-secret"}
        ]}

        %% WebRTC eturnal STUN/TURN URL 列表（凭据 secret 走 SECTION C）
        , {eturnal_turn_urls, []}
        , {eturnal_stun_urls, []}

        ,  {guanco, [
           {ollama_api_url, "http://localhost:11434"},
           {pool_size, 5},
           {max_overflow, 10}
         ]}

        , {sms, [
            {switch, <<"off">>}
            , {default_code, <<"6666">>}
            , {platform, <<"aliyun">>}
            , {<<"aliyun">>, [
                {sign_name, <<"xxx"/utf8>>}
                , {template_code, <<>>}
                , {key_id, <<>>}
                , {key_secret, <<>>}
                , {region_id, <<"cn-shenzhen">>}
            ]}
        ]}

        %% 数据库配置（连接池/迁移路径）— 密码走 SECTION C
        , {sql_driver, pgsql}
        , {pg_conf
            , #{name => pgsql,
                max_count => 80,
                init_count => 5,
                start_mfa => {
                    epgsql
                    , connect
                    , [
                        #{
                            %% 指向 docker 容器 imboy_pg18（PG 18.1 + TimescaleDB 2.23.1 + pgcrypto 1.4）
                            %% 取代 macOS homebrew 本地 5432（pgcrypto 动态库 18.1_1 vs 18.3 符号错位）
                            host => "127.0.0.1"
                            , username => "imboy_user"
                            %% 生产环境通过 IMBOY_PG_PASSWORD 环境变量设置
                            , password => "abc54321"
                            , database => "imboy_v1"
                            , port => 4323
                            , ssl => false
                            , timeout => 4000
                            ,  codecs => [{epgsql_codec_rfc3339_bin, []}]
                        }
                    ]
                }
            }
        }
        %% 能够创建表删除表的超级数据库用户
        %% 生产环境通过 IMBOY_PG_* 环境变量设置
        , {super_account, #{
            host => "127.0.0.1"
            , username => "imboy_user"
            , password => "abc54321"
            , database => "imboy_v1"
            , port => 4323
            , ssl => false
            , timeout => 4000
        }}
        %% 这里用绝对路径
        %% 注意：code:priv_dir(imboy) 已包含 /priv，所以只需 $PROJECT_DIR/migrations
        , {scripts_path, "$PROJECT_DIR/migrations"}

        %% 是否在启动时自动加载额外配置文件
        , {auto_load_configs, true}
        %% 配置文件管理
        %% 指定额外的配置文件路径，这些配置会在应用启动时动态加载
        , {config_files, [
            {debug_config, "config/debug.config"},
            {cron_config, "config/cron.config"}
        ]}

        % 启用分布式缓存同步功能
        , {dsync_enabled, true}

        %% Depcache settings,
        , {depcache, [
            % maximum size in mbs
            {depcache_memory_max, 100}
        ]}

        % SMTP 邮件发送（用户名/密码走 SECTION C）
        % smtp 配置参考 https://github.com/gen-smtp/gen_smtp
        , {smtp_option, [
            {relay, "smtp.qq.com"}
            , {ssl, true}
            , {auth,always}
            , {trace_fun, fun io:format/2}
            , {username, ""}
            , {password, ""}
        ]}

        , {crontab_jobs, [
            %% {JobName, CrontabSpec, {M, F, A}}
            %% {JobName, CrontabSpec, {M, F, A}, StartDateTime, EndDateTime}
            %% CrontabSpec
            %%  1. "Minute Hour DayOfMonth Month DayOfWeek"
            %%  2. "Second Minute Hour DayOfMonth Month DayOfWeek"
            %%  3. @yearly | @annually | @monthly | @weekly | @daily | @midnight | @hourly | @minutely
            %%  4. @every 1h2m3s

            %% Standard crontab spec without second (default second is 0 not *).
            {crontab_job, "*/15 * * * *", {demo_cron_logic, inspect, ["Runs on 0, 15, 30, 45 minutes"]}},
            %% Extend crontab spec with second.
            {extend_crontab_job, "0 0 1-6/2,18 * * *", {demo_cron_logic, inspect, ["Runs on 1,3,6,18 o'clock"]}},
            %% Crontab spec with alphabet.
            {alphabet_job, "@hourly", {demo_cron_logic, inspect, ["Runs every(0-23) o'clock"]}},
            %% Fixed interval spec.
            {fixed_interval_job, "@every 5m", {demo_cron_logic, inspect, ["Runs every 5 minutes"]}},
            %% Job with startDateTime and EndDateTime. Runs 0-23 o'clock since {11,0,0}.
            {limit_datetime_job, "@hourly", {demo_cron_logic, inspect, ["Runs every(0-23) o'clock"]}, {11, 0, 0}, unlimited},
            %% Job with max run count, default is `unlimited`
            {max_run_count_job, "@daily", {demo_cron_logic, inspect, ["Runs daily"]}, unlimited, unlimited, [{max_count, 1000}]},
            %% Parallel job, singleton default is true.
            {no_singleton_job, "@minutely", {timer, sleep, [61000]}, unlimited, unlimited, [{singleton, false}]}
        ]}

        %% ====================================================================
        %% SECTION C — 敏感凭据（默认留空；生产必须由 IMBOY_* 环境变量覆盖）
        %% Section C — Secrets (default blank; prod MUST come from IMBOY_* env)
        %%
        %% 启动 fail-fast 校验：src/imboy_app.erl: validate_runtime_config/0
        %% 环境变量映射：见 src/lib/imboy_env.erl 顶部注释
        %% 不要在本文件填入真实凭据；不要把 production secrets 提交到 git
        %% ====================================================================

        % jwt_key binary 32 — IMBOY_JWT_KEY
        , {jwt_key, <<>>}

        %% 管理后台 Cookie 签名密钥（jwt_key 为空时的 fallback）
        %% 生产环境通过 IMBOY_ADM_COOKIE_SECRET 环境变量设置
        , {adm_cookie_secret, ""}

        % 用于postgresql 存储数据的AES密钥 Key binary 32 — IMBOY_POSTGRE_AES_KEY
        , {postgre_aes_key, <<>>}

        %% 客户端 init 响应加密 + HMAC 签名密钥
        %% solidified_key : AES-256-CBC / HMAC-SHA512，必须 32 字节
        %% solidified_key_iv: AES-256-CBC IV，必须 16 字节
        %% dev/local 留空 — 使用 imboy_app:ensure_solidified_keys/0 的稳定默认值
        %%           （与 Flutter 客户端硬编码一致，见 imboyapp/lib/service/encrypter.dart）
        %% prod 必须通过 IMBOY_SOLIDIFIED_KEY / IMBOY_SOLIDIFIED_KEY_IV 注入，否则启动 fail-fast
        , {solidified_key, <<>>}
        , {solidified_key_iv, <<>>}

        %% RSA 密钥文件路径（PEM 格式）
        %% dev/local 留空 — 启动时自动落盘到 priv/dev_keys/login_rsa_{pub,priv}.pem
        %%           （首次启动生成，后续复用，保证客户端缓存的公钥持续有效）
        %% prod 必须通过 IMBOY_LOGIN_RSA_PUB_KEY_FILE / IMBOY_LOGIN_RSA_PRIV_KEY_FILE
        %%      指向 release 外的持久路径，否则启动 fail-fast
        %% 生产环境生成方式：
        %%   openssl genrsa -out /etc/imboy/keys/login_rsa_priv.pem 2048
        %%   openssl rsa -in /etc/imboy/keys/login_rsa_priv.pem -pubout -out /etc/imboy/keys/login_rsa_pub.pem
        , {login_rsa_pub_key_file,  ""}
        , {login_rsa_priv_key_file, ""}
        %% 极光认证 RSA 私钥（可与 login_rsa_priv_key_file 相同或独立）
        , {jverification_rsa_priv_key_file, ""}

        %% WebRTC TURN/STUN eturnal 集成凭据
        %% eturnal_secret 必须与 eturnal 服务端配置的 secret 一致
        %% 通过 IMBOY_ETURNAL_SECRET 环境变量设置
        , {eturnal_secret, <<>>}

        %% 历史 MD5 密码盐值（仅用于旧密码回退验证，新密码使用 hmac_sha512 自带随机 salt）
        %% ⚠️  一旦投产后不可更改，否则已存储的旧格式密码将永久失效
        %% IMBOY_PASSWORD_SALT
        , {password_salt, <<>>}

        %% 极光推送 / 极光短信 (jPush / jSMS) 凭据
        %% IMBOY_JPUSH_APP_KEY / IMBOY_JPUSH_MASTER_SECRET
        , {jpush_app_key, <<>>}
        , {jpush_master_secret, <<>>}

        %% 云极短信 (yjSMS) 凭据
        %% IMBOY_YJSMS_ACCOUNT / IMBOY_YJSMS_SECRET
        , {yjsms_account, <<>>}
        , {yjsms_secret, <<>>}
        , {yjsms_url, <<>>}
    ]}

    %% =============================================================
    %% 基础设施依赖（throttle / sync / sasl / lager / kernel / ecron）
    %% Infrastructure deps — 不属于业务配置，按 OTP 习惯单独放置
    %% =============================================================

    , {throttle, [
        {rates, [
            {refreshtoken, 11, per_minute}
            , {refreshtoken, 5, per_second}
            , {throttle_ws, 22, per_minute}
            , {throttle_ws, 10, per_second}
            , {three_second_once, 1, 3000} % 3 秒 1次
            , {per_hour_once, 1, per_hour}
            , {per_minute_once, 1, per_minute}
            , {api_per_user, 120, per_minute}  % 每用户每分钟 API 调用上限
            , {api_per_ip, 60, per_minute}     % 每 IP 每分钟 API 调用上限
            , {msg_per_user, 60, per_minute}   % 每用户每分钟消息发送上限
        ]}
    ]}
    , {sync, [
        {growl, all},
        {log, all},
        {non_descendants, fix},
        {executable, auto},
        {whitelisted_modules, []},
        {excluded_modules, [
            "deps/*"
        ]},
        {include, ["include"]}
    ]}

    %% Lager Begin %%%
    , {sasl, [
        {utc_log, true},
        {sasl_error_logger, {file, "log/sasl-error.log"}},
        {errlog_type, error},
        {error_logger_mf_dir, "log/sasl"},      % Log directory
        {error_logger_mf_maxbytes, 104857600},   % 100 MB max file size
        {error_logger_mf_maxfiles, 255}           % 255 files max
    ]}
    , {lager, [
        %% 日志根目录（注意：确保该目录有写入权限）
        {log_root, "./log"}
        %% What handlers to install with what arguments
        , {handlers, [
            {lager_console_backend, [{level, info},{formatter, lager_default_formatter},
                {formatter_config, [color, date," ",time, " [", severity, "] ", node,"#",pid, " ", message, "\n"]}]}
            , {lager_file_backend, [
                {file, "error.log"}, {level, error}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
            , {lager_file_backend, [
                {file, "debug.log"}, {level, info}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
        ]}
        , {colored,true} % 启用颜色
        %% 控制台日志颜色配置（仅对lager_default_formatter生效）
        , {colors, [
            {debug,     "\e[0;38m"},  % 灰色
            {info,      "\e[1;32m"},  % 绿色
            {notice,    "\e[1;36m"},  % 青色
            {warning,   "\e[1;33m"},  % 黄色
            {error,     "\e[1;31m"},  % 红色
            {critical,  "\e[1;35m"},  % 紫色
            {alert,     "\e[1;44m"},  % 蓝底白字
            {emergency, "\e[1;41m"}   % 红底白字
        ]}
    ]}
    , {kernel, [
        {start_timer, true}
        , {logger_level, info}
    ]}
    %% Lager End %%%

    , {ecron, [
        {time_zone, local}, %% local or utc
        {global_quorum_size, 1},
        {global_jobs, [
            % 6个星号分别表示 秒，分钟、小时、日、月、周几
            % {global_crontab_job, "*/1 * * * * *", {demo_cron_logic, inspect, ["Runs on 0, 15, 30, 45 seconds"]}}
        ]}
    ]}

    , {kernel, [
        {start_timer, true}
        , {logger_level, all}
    ]}
].
