%% ============================================================
%% 本地开发配置模板 / Local dev config TEMPLATE
%% ------------------------------------------------------------
%% 用法 / Usage:
%%   cp config/sys.local.config.example config/sys.local.config
%%   然后填入真实值。sys.local.config 已被 .gitignore 排除（*local*.config），
%%   切勿提交。Fill in real values; sys.local.config is gitignored — never commit it.
%%
%% 生成 32 字节随机密钥 / Generate a 32-byte secret:
%%   openssl rand -hex 16          %% → 32 hex chars (= 16 bytes), 用两次拼 32 字节
%%   openssl rand -base64 24       %% 或 base64
%% ============================================================
[
    {imboy, [
        {http_port, 9800}
        , {http_port_adm, 9806}
        %% 本地开发关闭签名验证（app_version 表为空时 sign_key 返回 <<>> 导致 902）
        , {api_auth_switch, <<"off">>}
        , {host, '_'}

        , {cacertfile, "/ssl/cowboy-ca.crt"}
        , {certfile, "/ssl/server.crt"}
        , {keyfile, "/ssl/server.key"}
        , {base_url, <<"https://dev.example.local">>}

        , {cors_allowed_origins, [
            <<"https://dev.example.local">>,
            <<"http://localhost:8082">>
        ]}
        , {cors_allow_localhost, true}

        %% ws_url: 真机直传/连接必须用 LAN IP（127.0.0.1 在手机上指向手机自身）
        , {ws_url, <<"ws://YOUR_LAN_IP:9800/ws">>}
        , {upload_url, <<"https://upload.example.local">>}
        , {upload_key, <<"CHANGE_ME_UPLOAD_KEY">>}
        , {upload_scene, <<"pro">>}

        %% Garage S3：endpoint 会签入 presigned 直传 URL，必须客户端可达（真机用 LAN IP）
        , {garage, #{
            endpoint   => <<"http://YOUR_LAN_IP:3900">>,
            region     => <<"garage">>,
            bucket     => <<"imboy">>,
            access_key => <<"CHANGE_ME_GARAGE_ACCESS_KEY">>,
            secret_key => <<"CHANGE_ME_GARAGE_SECRET_KEY">>
        }}

        , {adm_cookie_secret, "CHANGE_ME_ADM_COOKIE_SECRET"}

        %% 万能验证码（仅 local/test 环境）
        , {verification_master_code, <<"CHANGE_ME_MASTER_CODE">>}

        %% PostgreSQL 字段加密 AES 密钥，必须 32 字节 / must be exactly 32 bytes
        , {postgre_aes_key, <<"CHANGE_ME_32_BYTES_AES_KEY______">>}

        %% 百度千帆大模型（可选 / optional）
        , {qianfan, #{
            app_id => 0, api_key => <<"CHANGE_ME">>
            , secret_key => <<"CHANGE_ME">>
            , auth_access_key => <<"CHANGE_ME">>
            , auth_secret_key => <<"CHANGE_ME">>
        }}

        %% SMTP（可选）参考 https://github.com/gen-smtp/gen_smtp
        , {smtp_option, [
            {relay, "smtp.example.com"}
            , {ssl, true}
            , {auth, always}
            , {trace_fun, fun io:format/2}
            , {username, "CHANGE_ME@example.com"}
            , {password, "CHANGE_ME_SMTP_PASSWORD"}
        ]}

        , {sms, [
            {switch, <<"off">>}
            , {default_code, <<"6666">>}
            , {platform, <<"aliyun">>}
            , {<<"aliyun">>, [
                {sign_name, <<"xxx"/utf8>>}
                , {template_code, <<"">>}
                , {key_id, <<"">>}
                , {key_secret, <<"">>}
                , {region_id, <<"cn-shenzhen">>}
            ]}
        ]}

        , {sql_driver, pgsql}
        , {pg_conf
            , #{name => pgsql,
                max_count => 80,
                init_count => 5,
                start_mfa => {
                    epgsql
                    , connect
                    , [
                        #{
                            host => "127.0.0.1"
                            , username => "imboy_user"
                            , password => "CHANGE_ME_PG_PASSWORD"
                            , database => "imboy_v1"
                            , port => 4323
                            , ssl => false
                            , timeout => 4000
                            , codecs => [{epgsql_codec_rfc3339_bin, []}]
                        }
                    ]
                }
            }
        }
        %% 能够创建/删除表的超级数据库用户
        , {super_account, #{
            host => "127.0.0.1"
            , username => "imboy_user"
            , password => "CHANGE_ME_PG_PASSWORD"
            , database => "imboy_v1"
            , port => 4323
            , ssl => false
            , timeout => 4000
        }}
        , {scripts_path, "$PROJECT_DIR/migrations"}

        , {depcache, [
            {depcache_memory_max, 100}
        ]}
        , {redis_options, [{password, "CHANGE_ME_REDIS_PASSWORD"}, {database, 0}, {host, "127.0.0.1"}, {port, 6378}]}

        , {msg_archive_enabled, true}

        %% Feature flags
        , {features, #{
            core => #{enabled => true},
            e2ee => #{enabled => true},
            channel => #{enabled => true},
            location => #{enabled => true},
            moment => #{enabled => true},
            channel_discover => #{enabled => true},
            channel_invitation => #{enabled => true},
            channel_order => #{enabled => true},
            group_vote => #{enabled => true},
            group_schedule => #{enabled => true},
            group_task => #{enabled => true}
        }}
    ]}

    , {throttle, [
        {rates, [
            {refreshtoken, 11, per_minute}
            , {refreshtoken, 5, per_second}
            , {throttle_ws, 22, per_minute}
            , {throttle_ws, 10, per_second}
            , {three_second_once, 1, 3000}
            , {per_hour_once, 1, per_hour}
            , {per_minute_once, 1, per_minute}
            , {e2ee_report_key, 10, per_hour}
            , {e2ee_create_shards, 5, per_day}
            , {e2ee_decrypt_shard, 20, per_hour}
        ]}
    ]}

    , {sasl, [
        {utc_log, true},
        {sasl_error_logger, {file, "log/sasl-error.log"}},
        {errlog_type, error},
        {error_logger_mf_dir, "log/sasl"},
        {error_logger_mf_maxbytes, 104857600},
        {error_logger_mf_maxfiles, 255}
    ]}
    , {lager, [
        {log_root, "./log"}
        , {handlers, [
            {lager_console_backend, [{level, info},{formatter, lager_default_formatter},
                {formatter_config, [color, date," ",time, " [", severity, "] ", node,"#",pid, " ", message, "\n"]}]}
            , {lager_file_backend, [
                {file, "error.log"}, {level, error}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
            , {lager_file_backend, [
                {file, "debug.log"}, {level, info}, {size, 10485760}, {date, "$D0"}, {count, 999}]
            }
        ]}
        , {colored, true}
    ]}
    , {kernel, [
        {start_timer, true}
        , {logger_level, info}
    ]}
].
