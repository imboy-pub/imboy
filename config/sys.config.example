[
    {imboy, [
        {env, <<"dev">>},
        {http_port, 9800},
        {host, '_'},
        {start_mode, http},
        %% 蓝绿部署设 IMBOY_AUTO_MIGRATE=false，切流后再显式执行 db migrate。
        {auto_migrate, true},
        {base_url, <<"https://dev.imboy.pub">>},
        {cluster_nodes, []},
        {channel_revoke_window_seconds, 120},

        %% LLM providers registry consumed by imboy_llm_registry:lookup/1.
        %% 默认空列表 => 仅内置 qianfan（module 内置默认）可用；AI agent 需要
        %% 至少一个可用 provider 才会回复，请按需在此显式配置。
        %% 每个元素是一个 map：
        %%   name     : 必填 binary，provider 名称（客户端/业务按此名查找）
        %%   module   : 必填 atom，实现 imboy_llm behaviour 的模块
        %%   base_url : 可选 binary，OpenAI 兼容网关地址
        %%   api_key  : 可选 binary，敏感值——请用占位符，生产经 IMBOY_* 环境变量注入
        %%   model    : 可选 binary，模型名
        %% maps:without([name, module], Provider) 之外的字段会作为 chat/3 的 Opts 透传。
        %%
        %% 阿里云百炼为 OpenAI 兼容端点，复用 imboy_llm_openai：
        %%   通用 DashScope：base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
        %%   专属模型网关（key 以 sk-ws- 开头）：base_url 以 CSV 交付的
        %%   openAiCompatible 字段为准（本示例即专属网关）
        %%   export BAILIAN_API_KEY=<你的 dashscope api key>
        %%   export BAILIAN_MODEL=<模型ID>  （缺省 qwen3.7-flash）
        {llm_providers, [
            #{name => <<"qianfan">>, module => imboy_llm_qianfan},
            #{name => <<"openai">>, module => imboy_llm_openai,
              base_url => <<"https://api.deepseek.com/v1">>,
              %% 请勿在此写入真实密钥，运行时用 IMBOY_LLM_OPENAI_API_KEY 等注入
              api_key => <<"YOUR_API_KEY_HERE">>,
              model => <<"deepseek-chat">>},
            #{name => <<"bailian">>, module => imboy_llm_openai,
              base_url => <<"https://llm-zyz63lgdmo1wvx8k.cn-beijing.maas.aliyuncs.com/compatible-mode/v1">>,
              api_key => {env, <<"BAILIAN_API_KEY">>},
              model => {env, <<"BAILIAN_MODEL">>, <<"qwen3.7-flash">>}}
        ]},

        %% Stage 1 product policy skeleton:
        %% - `product_profile` and `capabilities` are now explicit config objects
        %% - current App/Admin feature payload shape remains unchanged
        %% - message/search/export/audit flows are not yet fully capability-enforced
        {product_profile, community},

        {capabilities, #{
            storage_mode => archived,
            e2ee_mode => optional,
            message_search => false,
            message_export => false,
            audit_mode => metadata,
            retention_policy => #{
                mode => rolling_days,
                days => 30
            }
        }},

        %% Feature flags consumed by:
        %% - GET /v1/app/features (public read-only feature matrix for App bootstrap)
        %% - GET /adm/admin/config/features (admin read-only feature matrix, requires settings:view)
        %% - both endpoints return a flat boolean payload of effective feature states
        %% Compatibility defaults in code:
        %% - missing `features` block => all known features are treated as enabled
        %% - missing feature item or missing `enabled` => treated as enabled
        %% - `channel_discover`, `channel_invitation`, `channel_order` depend on `channel`
        %% Recommendation: explicitly configure every shipped feature in production.
        {features, #{
            core => #{enabled => true},
            e2ee => #{enabled => false},
            channel => #{enabled => false},
            location => #{enabled => false},
            moment => #{enabled => false},
            channel_discover => #{enabled => false},
            channel_invitation => #{enabled => false},
            channel_order => #{enabled => false},
            group_vote => #{enabled => false},
            group_schedule => #{enabled => false},
            group_task => #{enabled => false}
        }},

        %% REQUIRED in production:
        %% - jwt_key: binary, 32+ bytes
        %% - postgre_aes_key: binary, 32+ bytes
        {jwt_key, <<"CHANGE_ME_WITH_32_BYTES_SECRET">>},
        {postgre_aes_key, <<"CHANGE_ME_WITH_32_BYTES_SECRET">>},
        {adm_cookie_secret, "CHANGE_ME_ADM_COOKIE_SECRET"},

        {sql_driver, pgsql},
        {pg_conf, #{
            name => pgsql,
            max_count => 80,
            init_count => 5,
            start_mfa => {epgsql, connect, [
                #{
                    host => "localhost",
                    username => "imboy_user",
                    password => "CHANGE_ME_DB_PASSWORD",
                    database => "imboy_v1",
                    port => 5432,
                    ssl => false,
                    timeout => 4000,
                    codecs => [{epgsql_codec_rfc3339_bin, []}]
                }
            ]}
        }},
        {super_account, #{
            host => "localhost",
            username => "imboy_user",
            password => "CHANGE_ME_DB_PASSWORD",
            database => "imboy_v1",
            port => 5432,
            ssl => false,
            timeout => 4000
        }},

        %% Default resolves to priv/migrations when config is invalid.
        {scripts_path, "$PROJECT_DIR/migrations"},
        {auto_load_configs, true},
        {config_files, [
            {debug_config, "config/debug.config"},
            {cron_config, "config/cron.config"}
        ]}
    ]},

    {throttle, [
        {rates, [
            {refreshtoken, 11, per_minute},
            {refreshtoken, 5, per_second},
            {throttle_ws, 22, per_minute},
            {throttle_ws, 10, per_second}
        ]}
    ]}
].
